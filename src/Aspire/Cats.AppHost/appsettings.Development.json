{
  "Logging": {
    "LogLevel": {
      "Cats": "Debug"
    }
  },
  "MigrationBehaviour": "WaitForCompletion",
  "Features": {
    "UseWorkerForJobs": true,
    "UseConsumer": true,
    "Redis": {
      "Enabled": true,
      "SignalRBackplane": true,
      "SessionStore": true
    },
    "UseDmsHardLinkApi": true,
    "PresenceHub": {
      "Enabled": true,
      "RelayUserPresenceNotifications": true
    },
    "EnablePrometheusScrapingEndpoint": true,
    "HmppsExternalApi": {
      "Enabled": true,
      "Events": {
        "Enabled": true
      }
    }
  }
}
