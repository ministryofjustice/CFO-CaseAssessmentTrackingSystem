@page "/pages/search"
@page "/pages/search/{Keyword}"

@inherits OwningComponentBase<IMediator>
@attribute [Authorize(Policy = SecurityPolicies.AuthorizedUser)]

@using Cfo.Cats.Server.UI.Services.Navigation

@inject IAsyncMenuService MenuService
@inject IWorkspaceLinkProvider LinkProvider

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private static readonly IReadOnlyList<BreadcrumbItem> Breadcrumbs =
    [
        new BreadcrumbItem("Search", "/pages/search", disabled: false)
    ];
}

<PageHeader Title="Search" Items="@Breadcrumbs" />

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

    <MudTextField T="string"
                  Value="@Keyword"
                  ValueChanged="@SearchChanged"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  OnKeyDown="@OnKeyDown"
                  Placeholder="Search for pages or participants by name or identifier..."
                  Class="mb-6" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_results.Count == 0 && !string.IsNullOrWhiteSpace(_searchedKeyword))
    {
        <MudAlert Severity="Severity.Warning">No results match "@_searchedKeyword".</MudAlert>
    }
    else if (_results.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Enter a search term..</MudAlert>
    }
    else
    {
        <MudList T="string">
            @foreach (var result in _results)
            {
                @switch (result)
                {
                    case PageResult page:
                        <MudListItem T="string"
                                     Icon="@Icons.Material.Filled.Description"
                                     Href="@(page.Href)">
                            <MudText Typo="Typo.body1">
                                <MudHighlighter HighlightedText="@_searchedKeyword" Text="@(page.DisplayText)" />
                            </MudText>
                            <MudText Typo="Typo.caption">
                                @(string.IsNullOrWhiteSpace(page.Section) ? "Page" : $"Page - {page.Section}")@(string.IsNullOrWhiteSpace(page.Description) ? "" : $" - {page.Description}")
                            </MudText>
                        </MudListItem>
                        break;
                    case ParticipantResult participant:
                        var p = participant.Participant;
                        <MudListItem T="string"
                                     Icon="@(!p.HasAccess ? Icons.Material.Filled.Lock : p.IsUnassigned ? Icons.Material.Filled.PersonSearch : Icons.Material.Filled.Person)"
                                     Href="@(p.HasAccess ? $"/pages/workspace/participants/{p.Id}" : null)"
                                     Disabled="@(!p.HasAccess)">
                            <MudText Typo="Typo.body1">
                                <MudHighlighter HighlightedText="@_searchedKeyword" Text="@p.FullName" />
                            </MudText>
                            <MudText Typo="Typo.caption">
                                @p.Id@(string.IsNullOrWhiteSpace(p.CurrentLocation) ? "" : $" - {p.CurrentLocation}")@(p.EnrolmentStatus is null ? "" : $" - {p.EnrolmentStatus.Name}")@(p.IsUnassigned ? " \u2014 Unassigned" : "")@(p.HasAccess ? "" : " \u2014 On the programme, you don't have access to this record")
                            </MudText>
                        </MudListItem>
                        break;
                }
            }
        </MudList>
    }
</MudContainer>