@using Humanizer
@inherits CatsComponentBase


<MudCard Style="height: 100%">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText>
                Risk Information
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton OnClick="@ExpandRiskInformation" Icon="@Icons.Material.Outlined.OpenInNew" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <DataList>
            <ChildContent>
                @if (ParticipantSummaryDto.LatestRisk is not null)
                {
                    <DataListItem Label="Last Reviewed" HelperText="@ParticipantSummaryDto.LatestRisk!.Created.Humanize()">
                        @ParticipantSummaryDto.LatestRisk.Created.ToShortDateString() 
                    </DataListItem>
                    <DataListItem Label="Reviewed By">
                        @UserService.DataSource.First(u => u.Id == ParticipantSummaryDto.LatestRisk!.CreatedBy).DisplayName
                    </DataListItem>
                }
                <DataListItem Label="Risk Due" HelperText="@(ParticipantSummaryDto.RiskDue.HasValue ? ParticipantSummaryDto.RiskDue.Value.Humanize() : "")">
                    <MudStack Row="true" StretchItems="StretchItems.Start">
                        <MudText>
                            @ParticipantSummaryDto.RiskDue.ToShortDateOrEmptyString()
                        </MudText>
                        <MudIcon Size="Size.Small" 
                            Icon="@(ParticipantSummaryDto.RiskDue < DateTime.Today ? Icons.Material.Filled.Error : Icons.Material.Filled.Info)"
                            Color="@(ParticipantSummaryDto.RiskDue < DateTime.Today ? Color.Error : Color.Info)"></MudIcon>
                    </MudStack>
                </DataListItem>
                <DataListItem Label="Reason" HelperText="">
                    <MudText>
                        @ParticipantSummaryDto.RiskDueReason
                    </MudText>
                </DataListItem>
            </ChildContent>
        </DataList>
    </MudCardContent>
    <MudCardActions>
        @if (CanAddRiskInformation())
        {
            <MudButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" OnClick="@OnClickAddRiskInformation">
                Add Risk
            </MudButton>
        }
        @if (CanReviewRiskInformation())
        {
            <MudButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Redo" Variant="Variant.Filled" OnClick="@ReviewRiskInformation">
                Review Risk
            </MudButton>
        }        
    </MudCardActions>
</MudCard>

