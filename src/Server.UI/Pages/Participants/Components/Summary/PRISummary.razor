@using Cfo.Cats.Domain.Common.Enums
@using Humanizer
@inherits CatsComponentBase

<MudCard Style="Height: 100%;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">Latest Pre-Release Inventory (PRI)</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (_latestPri is null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @_noPriInfo
            </MudAlert> 
        }
        else
        {

            <DataList>
                <ChildContent>
                    <DataListItem Label="Date Created" HelperText="@_latestPri.Created.Humanize()">
                        @_latestPri.Created.ToShortDateString()
                    </DataListItem>
                    <DataListItem Label="Actual Release Date">
                        <MudText>
                            @_latestPri.ActualReleaseDate.ToShortDateOrDefault("None")
                        </MudText>
                    </DataListItem>

                    @if (_latestPri.Status == PriStatus.Completed || _latestPri.Status == PriStatus.Abandoned)
                    {
                        <DataListItem Label="@($"Date {_latestPri.Status.Name}")" HelperText="@_latestPri.CompletedOn!.Value.Humanize()">
                            @_latestPri.CompletedOn.ToShortDateOrEmptyString()
                        </DataListItem>

                        if (_latestPri.Status == PriStatus.Abandoned)
                        {
                            <DataListItem Label="@($"{_latestPri.Status.Name} Reason")">
                                @_latestPri.AbandonReason
                            </DataListItem>
                        }
                    }

                    @if(_showTtgDue)
                    {
                        <DataListItem Label="TTG Due" HelperText="@_latestPri.TTGDueDate.Humanize()">
                            <MudStack Row="true" StretchItems="StretchItems.Start">
                                <MudText>
                                    @_priDueInfo
                                </MudText>
                                <MudIcon Size="Size.Small"
                                    Color="@_priDueIconColor"
                                    Icon="@_priDueIcon">
                                </MudIcon>
                            </MudStack>
                        </DataListItem>
                    }


                </ChildContent>
            </DataList>
        }
    </MudCardContent>
    
    <MudCardActions>
        @if (CanAddPri())
        {
            <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" OnClick="@BeginPri">
                Create PRI
            </MudButton>
        }
    </MudCardActions>
</MudCard>