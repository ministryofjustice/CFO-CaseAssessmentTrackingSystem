@using Humanizer
@inherits CatsComponentBase

<MudCard Style="height: 100%">
    <MudCardHeader>
        <MudText>
            Latest Assessment
        </MudText>
    </MudCardHeader>
    <MudCardContent>
        @if(_latestAssessment is null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @_noAssessmentInfo
            </MudAlert>
        }
        
        @if(_latestAssessment is not null)
        {
            <DataList>
                <ChildContent>
                    <DataListItem 
                        Label="Date Created" 
                        HelperText="@_latestAssessment.AssessmentDate!.Value.Humanize()">
                            @_latestAssessment.AssessmentDate!.Value.ToShortDateString()
                    </DataListItem>
                    <DataListItem Label="Created By">
                        @(UserService.DataSource.First(u => u.Id == _latestAssessment.AssessmentCreator).DisplayName)
                    </DataListItem>
                    @if(_latestAssessment.Completed.HasValue)
                    {
                        <DataListItem
                            Label="Date Completed"
                            HelperText="@_latestAssessment.Completed.Value.Humanize()">
                            @_latestAssessment.Completed.Value.ToShortDateString()
                        </DataListItem>
                        <DataListItem Label="Due Date" HelperText="@_assessmentDueInfo">
                            <MudStack Row="true" StretchItems="StretchItems.Start">
                                @(_latestAssessment.Completed.HasValue ? _latestAssessment.Completed.Value.AddMonths(3).ToShortDateString() : "")
                                @if (_assessmentDueInfo is not "")
                                {
                                    <MudIcon Size="Size.Small" Icon="@_assessmentDueIcon" Color="_assessmentDueIconColor" />
                                }
                            </MudStack>
                            
                        </DataListItem>
                    }
                    else
                    {
                        <DataListItem Label="Due Date" HelperText="@_assessmentDueInfo">
                            <MudStack Row="true" StretchItems="StretchItems.Start">
                                @_AssessmentNotCompletedInfo
                                @if (_assessmentDueInfo is not "")
                                {
                                    <MudIcon Size="Size.Small" Icon="@_assessmentDueIcon" Color="_assessmentDueIconColor" />
                                }
                            </MudStack>
                            
                        </DataListItem>
                    }

                </ChildContent>
            </DataList>


        }
    </MudCardContent>
    <MudCardActions>
        @if (CanBeginAssessment())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="BeginAssessment">
                Add Assessment
            </MudButton>
        }

        @if (CanContinueAssessment())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ContinueAssessment">
                Resume
            </MudButton>            
        }

        @if (CanReassess())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="BeginAssessment">
                Reassess
            </MudButton>
        }
    </MudCardActions>
</MudCard>

