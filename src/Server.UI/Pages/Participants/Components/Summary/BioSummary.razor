@using Humanizer

@inherits CatsComponentBase

<MudCard Style="Height: 100%;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">Bio Information</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>

        @if (_bio is null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                No Bio has been created.
            </MudAlert>
        }

        <DataList>
            <ChildContent>
                @if(_bio is not null)
                {
                    <DataListItem Label="Date Created" HelperText="@_bio.BioDate!.Value.Humanize()">
                        <MudText>
                            @_bio.BioDate!.Value.ToShortDateString()
                        </MudText>
                    </DataListItem>
                    <DataListItem Label="Created By">
                        <MudText>
                            @UserService.DataSource.First(u => u.Id == _bio.BioCreator).DisplayName
                        </MudText>
                    </DataListItem>
                    <DataListItem Label="Status">
                            @_bio.BioStatus!.Name.Humanize()
                    </DataListItem>
                }

                @if(ParticipantSummaryDto.BioDue is not null)
                {
                    <DataListItem Label="Bio Due" HelperText="@ParticipantSummaryDto.BioDue.Value.Date.Humanize()">
                        <MudStack Row="true" StretchItems="StretchItems.Start">
                            <MudText>
                                @ParticipantSummaryDto.BioDue.Value.Date.ToShortDateString()
                            </MudText>
                            <MudIcon Size="Size.Small" Icon="@_bioIcon" Color="@_bioIconColor"></MudIcon>
                        </MudStack>

                    </DataListItem>
                }

            </ChildContent>
        </DataList>

    </MudCardContent>

    <MudCardActions>
        @if (CanBeginBio())
        {
            <MudTooltip Text=@ConstantString.AddBio>
                <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" OnClick="@BeginBio">
                    @ConstantString.AddBio
                </MudButton>
            </MudTooltip>
        }

        @if (CanContinueBio())
        {
            <MudTooltip Text=@ConstantString.ResumeBio>
                <MudButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ChevronRight" Variant="Variant.Filled" OnClick="@ContinueBio">
                    @ConstantString.ResumeBio
                </MudButton>
            </MudTooltip>
        }

        @if (CanRestartBio())
        {
            <MudTooltip Text=@ConstantString.RestartBio>
                <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Redo" Variant="Variant.Filled" OnClick="@BeginBio">
                   @ConstantString.RestartBio
                </MudButton>
            </MudTooltip>
        }
    </MudCardActions>
</MudCard>