@using Cfo.Cats.Application.Features.Assessments.DTOs

@if (Assessment is not null)
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
        @foreach (var title in OrderedTitles)
        {
            var pathway = Assessment.PathwayScore.FirstOrDefault(p => p.Pathway == title);

            if (pathway != null)
            {
                <RagComponent Pathway="pathway" />
            }
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public ParticipantAssessmentDto? Assessment { get; set; }

    private static readonly string[] OrderedTitles =
    [
        "Working",
        "Housing",
        "Money",
        "Education",
        "Health & Addiction",
        "Relationships",
        "Thoughts & Behaviours",
        "Wellbeing & Mental Health"
    ];
}
