@using Humanizer;

@inherits CatsComponentBase


@if(_paginatedNotes is not null)
{

    <MudPaper Class="pa-3">

        <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mb-2">
            <MudPagination Count="@TotalPages"
                            ShowFirstButton="true"
                            ShowLastButton="true"
                            SelectedChanged="OnPaginationChanged">
            </MudPagination>
            <MudText Typo="Typo.body1">
                @TotalNotes @(TotalNotes == 1 ? "note" : "notes")
            </MudText>
            <MudSpacer />
            @if (AllowAddNote)
            {
                <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" OnClick="@OnAddNote"> Add Note</MudButton>
            }
        </MudStack>

        <MudStack Spacing="2">
            @foreach(var note in PagedNotes)
            {
                <MudPaper Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudAvatar Size="Size.Small">
                            @note.CreatedBy.Substring(0, 1)
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle1">@note.CreatedBy</MudText>
                        <MudTooltip Text="@note.Created.ToLocalTime().ToString("ddd, dd MMM yyyy 'at' HH:mm")">
                            <MudText Typo="Typo.caption">@note.Created.Humanize()</MudText>
                        </MudTooltip>
                    </MudStack>
                    <MudText Class="mt-2">
                        @if (note.CallReference is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                Call Reference @note.CallReference
                            </MudChip>
                        }
                        @note.Message
                    </MudText>
                </MudPaper>
            }
        </MudStack>
    </MudPaper>

   
}
