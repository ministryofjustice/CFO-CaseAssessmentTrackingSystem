@using Cfo.Cats.Application.Features.Assessments.DTOs
@using Cfo.Cats.Application.Features.Assessments.Queries

@inherits CatsComponent<ParticipantAssessmentDto[]>

@if(ErrorMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="Severity.Error">
        @ErrorMessage
    </MudAlert>
} 

@if (Data is { Length: 1 })
{
    <RagBarDisplay Assessment="Data[0]" />
}