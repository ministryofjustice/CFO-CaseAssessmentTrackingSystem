@page "/pages/workspace/my-area/my-documents"
@using Cfo.Cats.Domain.Entities.Documents
@using Cfo.Cats.Application.Features.Documents.DTOs
@using Cfo.Cats.Server.UI.Pages.Dashboard.Components
@using Cfo.Cats.Server.UI.Pages.Workspaces.MyArea.Components
@using Humanizer

@inherits CatsComponent<GeneratedDocumentDto[]>

<MyAreaPageHeader />

@if(Loading)
{
    <LoadingCard Title="Getting documents" />
}

@if(ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Warning">
        @ErrorMessage
    </MudAlert>
}

@if(Data is not null)
{
    <MudTable Dense="true" Striped="true" Items="Data"
    Hover="true"
    Breakpoint="Breakpoint.Sm"
    Loading="@Loading"
    LoadingProgressColor="Color.Info"
    Filter="FilterFunc"
    Class="mb-8 pa-4">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="searchString" Placeholder="Search" Immediate="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            <MudTooltip Text="Clear search parameters">
                <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Clear" OnClick="@(() => searchString = string.Empty)" />
            </MudTooltip>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@ConstantString.Actions</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>File Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Requested on</MudTh>
            <MudTh>Available until</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@ConstantString.Actions">
                <MudMenu Disabled="context.IsReadyForDownload is false" Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Size="Size.Small" Dense="true" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                    <MudMenuItem OnClick="async() => await Download(context)">Download</MudMenuItem>
                </MudMenu>
            </MudTd>
            <MudTd DataLabel="Status">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">
                        @{
                            Color color = context.Status switch
                            {
                                DocumentStatus.Processing => Color.Info,
                                DocumentStatus.Available => Color.Success,
                                DocumentStatus.Error => Color.Error,
                                _ => Color.Primary
                            };
                        }
                        <MudChip T="string" Color="color" Size="Size.Small">@context.Status.Humanize()</MudChip>
                    </MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="File Name">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.Title</MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="Description">
                @{
                    var (summary, filters) = SplitDescription(context.Description);
                }
                <div class="d-flex flex-column">
                    <div class="d-flex align-center">
                        <MudText Typo="Typo.body1" Class="flex-grow-1">@summary</MudText>
                        @if (filters.Length > 0)
                        {
                            <MudIconButton Size="Size.Small"
                                           Class="ml-auto"
                                           Icon="@(_expandedIds.Contains(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                           OnClick="@(() => ToggleExpanded(context.Id))" />
                        }
                    </div>
                    @if (filters.Length > 0)
                    {
                        <MudCollapse Expanded="@_expandedIds.Contains(context.Id)">
                            <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="white-space: pre-line; color: gray;">
                                @string.Join("\n", filters)
                            </MudText>
                        </MudCollapse>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Requested on">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.Created.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                    <MudText Typo="Typo.body1">(@context.Created.Humanize())</MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="Available until">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.ExpiresOn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                    <MudText Typo="Typo.body1">(@context.ExpiresOn.Humanize())</MudText>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@(string.IsNullOrWhiteSpace(searchString) ? "You have no documents available." : "No documents match the current search.")</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

