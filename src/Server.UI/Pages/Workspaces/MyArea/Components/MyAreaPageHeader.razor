@using Cfo.Cats.Server.UI.Services.Navigation

@inject IStringLocalizer<MyAreaPageHeader> L

<PageHeader Title="@L["My Account"]" Items="@_breadcrumbs" />

@code {

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnParametersSet()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _breadcrumbs = WorkspaceRegistry.TrailFor(Workspace.MyArea, uri.AbsolutePath)
            .Items
            .Select(link => link.AsMudBreadcrumb())
            .ToList();
    }
}
