@using Cfo.Cats.Server.UI.Services.Navigation

<PageHeader Title="Administration" 
            Items="@_breadcrumbs" />

@code
{
    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnParametersSet()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        _breadcrumbs = WorkspaceRegistry.TrailFor(Workspace.Administration, uri.AbsolutePath)
            .Items
            .Select(link => link.AsMudBreadcrumb())
            .ToList();
    }
}
