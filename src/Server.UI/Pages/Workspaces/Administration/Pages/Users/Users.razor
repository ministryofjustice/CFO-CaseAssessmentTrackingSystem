@page "/pages/workspace/administration/users/users"

@using Cfo.Cats.Application.Features.Identity.DTOs
@using Cfo.Cats.Server.UI.Pages.Identity.Roles.Components
@using Cfo.Cats.Application.Common.Interfaces.Identity
@using Cfo.Cats.Application.Common.Interfaces.MultiTenant
@using ZiggyCreatures.Caching.Fusion
@using Cfo.Cats.Infrastructure.Services
@using Cfo.Cats.Server.UI.Pages.Workspaces.Administration.Components

@attribute [Authorize(Policy = SecurityPolicies.SystemFunctionsRead)]
@inherits CatsComponentBase

@implements IDisposable

@inject IUsersStateContainer UsersStateContainer
@inject IUserService UserService
@inject ITenantService TenantsService
@inject IFusionCache FusionCache;
@inject IFusionCache Cache;
@inject INetworkIpProvider NetworkIpProvider
@inject IStringLocalizer<Users> L
@inject ILogger<Users> Logger

<AdministrationPageHeader />
<PageTitle>@Title</PageTitle>

@if(_initialised)
{
    <UserFilterBar
        SearchString="@_searchString"
        SelectedTenantId="@_selectedTenantId"
        SelectedRole="@_searchRole"
        SelectedStatus="@_selectedStatus"
        CurrentPage="@_currentPage"
        TotalPages="@_totalPages"
        TotalItems="@_totalItems"
        IsDownloading="@_downloading"
        CanCreate="@_canCreate"
        Tenants="@_tenants"
        Roles="@_roleNames"
        OnSearchChanged="@OnSearch"
        OnRefresh="@OnRefresh"
        OnExport="@OnExport"
        OnCreate="@OnCreate"
        OnShowTenantDialog="@ShowTenantDialog"
        OnShowRoleDialog="@ShowRoleDialog"
        OnStatusChanged="@OnStatusChanged"
        OnClearSearch="@ClearSearch"
        OnPageChanged="@OnPageChanged" />

    @if (_loading)
    {
        <MudLoading Text="Loading..." />
    }
    else if (_pagedUsers.Any())
    {
        <MudTable Dense="true" T="ApplicationUserDto" Items="@_pagedUsers" Hover="true" Striped="true" BreakPoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Style="width:40px"></MudTh>
                <MudTh Style="width:60px">@ConstantString.Actions</MudTh>
                <MudTh>@L[_currentDto.GetMemberDescription(x => x.TenantName)]</MudTh>
                <MudTh>@L[_currentDto.GetMemberDescription(x => x.UserName)]</MudTh>
                <MudTh>@L["Display Name / PhoneNumber"]</MudTh>
                <MudTh>@L[_currentDto.GetMemberDescription(x => x.SuperiorName)]</MudTh>
                <MudTh>@L[_currentDto.GetMemberDescription(x => x.AssignedRoles)]</MudTh>
                <MudTh>@L[_currentDto.GetMemberDescription(x => x.LastLogin)]</MudTh>
                <MudTh>@L[_currentDto.GetMemberDescription(x => x.Status)]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="">
                    @if (context.Notes.Any())
                    {
                        <MudIconButton Icon="@(IsUserExpanded(context.Id) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                       Size="Size.Small"
                                       OnClick="@(() => ToggleUserExpansion(context.Id))" />
                    }
                </MudTd>
                <MudTd DataLabel="@ConstantString.Actions">
                    @if (_canEdit || _canArchive || _canManageRoles || _canResetPassword || _canToggleActiveStatus || _canManagePermissions || _canUnlock)
                    {
                        <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Size="Size.Small"
                        Dense="true"
                        EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">

                            <MudMenuItem OnClick="@(() => ShowIdentityAuditDialog(context, "History"))">Audit</MudMenuItem>
                            @if (_canEdit)
                            {
                                <MudMenuItem OnClick="@(() => OnEdit(context))">@ConstantString.Edit</MudMenuItem>
                            }

                            @if (_canToggleActiveStatus)
                            {
                                @if (_canMarkUserInReview)
                                {
                                    @if (context.Status == UserStatus.Active)
                                    {
                                        <MudMenuItem OnClick="@(() => OnMarkAsInReview(context))">@L["Mark as In-Review"]</MudMenuItem>
                                    }
                                    @if (context.Status == UserStatus.MarkAsInReview || context.Status == UserStatus.Inactive || context.Status == UserStatus.Left)
                                    {
                                        <MudMenuItem OnClick="@(() => OnReactivate(context))">@L["Reactivate"]</MudMenuItem>
                                    }
                                }
                                @if (context.Status != UserStatus.Left)
                                {
                                    <MudMenuItem OnClick="@(() => OnMarkAsLeft(context))">@L["Mark as Left"]</MudMenuItem>
                                }
                            }
                            @if(CanResetPassword(context.AssignedRoles))
                            {
                                <MudMenuItem Disabled="@(context.Status != UserStatus.Active && context.Status != UserStatus.PendingActivation)" OnClick="@(() => OnResetPassword(context))">@L["Reset Password"]</MudMenuItem>
                            }
                            @if (_canUnlock)
                            {
                                @if (context.LockoutEnd is not null && context.Status != UserStatus.MarkAsInReview && context.Status != UserStatus.Left)
                                {
                                    <MudMenuItem OnClick="@(() => OnUnlock(context))">@L["Unlock"]</MudMenuItem>
                                }                          
                            }
                        </MudMenu>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                        StartIcon="@Icons.Material.Filled.DoNotTouch" IconColor="Color.Secondary" Size="Size.Small"
                        Color="Color.Surface">
                            @ConstantString.NoAllowed
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="@L[_currentDto.GetMemberDescription(x => x.TenantName)]">
                    <div>
                        <MudText Typo="Typo.body1">@context.TenantName</MudText>
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.TenantId</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L[_currentDto.GetMemberDescription(x => x.UserName)]">
                    <div class="d-flex align-items-center">
                        <MudBadge Color="@(IsOnline(context.DisplayName) ? Color.Success : Color.Error)" Overlap="false" Dot="true" Bordered="true">
                            <MudAvatar>
                                @if (string.IsNullOrEmpty(context.ProfilePictureDataUrl))
                                {
                                    @context.UserName.First()
                                }
                                else
                                {
                                    <MudImage Src="@context.ProfilePictureDataUrl"></MudImage>
                                }
                            </MudAvatar>
                        </MudBadge>
                        <div class="pl-3">
                            <MudText Class="ml-2 align-self-center">@context.UserName</MudText>
                            <MudText Typo="Typo.body1" Class="ml-2 align-self-center mud-text-secondary">@context.Email</MudText>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Display Name / PhoneNumber"]">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body1">@context.DisplayName</MudText>
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.PhoneNumber</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L[_currentDto.GetMemberDescription(x => x.SuperiorName)]">
                    @context.SuperiorName
                </MudTd>
                <MudTd DataLabel="@L[_currentDto.GetMemberDescription(x => x.AssignedRoles)]">
                    @if (context.AssignedRoles is not null)
                    {
                        foreach (var str in context.AssignedRoles)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@str</MudChip>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="@L[_currentDto.GetMemberDescription(x => x.LastLogin)]">
                    @context.LastLogin?.ToLocalTime()
                </MudTd>
                <MudTd DataLabel="@L[_currentDto.GetMemberDescription(x => x.Status)]">                    
                    <div>
                        <MudChip T="string" Class="flex-grow-0" Color="@GetStatusColor(context.Status)" Size="Size.Small" Icon="@GetStatusIcon(context.Status)">@L[context.Status.DisplayName]</MudChip>
                    </div>

                    @if (context.LockoutEnd is not null)
                    {
                        <div>
                            <MudChip T="string" OnClick="@(() => OnUnlock(context))" Class="flex-grow-0" Color="Color.Dark" Size="Size.Small" Icon="@Icons.Material.Filled.HighlightOff">@L["Locked"]</MudChip>
                        </div>
                    }
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (IsUserExpanded(context.Id) && context.Notes.Any())
                {
                    <MudTr>
                        <td colspan="9" style="padding: 0;">
                            <MudCard Elevation="0" Class="ma-2">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.body1">
                                            <strong>Notes for @context.DisplayName</strong>
                                        </MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true">
                                        <thead>
                                            <tr>
                                                <th>@L["Call Reference"]</th>
                                                <th>@L["Message"]</th>
                                                <th>@L["Created By"]</th>
                                                <th>@L["Created Date"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var note in context.Notes.OrderByDescending(x => x.Created))
                                            {
                                                <tr>
                                                    <td>@(note.CallReference ?? "None")</td>
                                                    <td>@note.Message</td>
                                                    <td>@(UserService.DataSource.SingleOrDefault(x => x.Id == note.CreatedBy)?.DisplayName ?? "Unknown")</td>
                                                    <td>@note.Created?.ToLocalTime()</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                </MudCardContent>
                            </MudCard>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">No users match the current filters.</MudAlert>
    }
    }

    <PermissionsDrawer OnAssignAllChanged="OnAssignAllChangedHandler" Waiting="@_processing" OnOpenChanged="OnOpenChangedHandler" Open="_showPermissionsDrawer" Permissions="_permissions" OnAssignChanged="OnAssignChangedHandler"></PermissionsDrawer>