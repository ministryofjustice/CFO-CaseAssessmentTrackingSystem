<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Group" Class="mr-3 mb-n1" />
            Select Role
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack>
            <MudTextField @bind-Value="_searchTerm" Placeholder="Search roles..." 
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />
            
            <MudList T="string" Dense="true">
                @foreach (var role in FilteredRoles)
                {
                    <MudListItem T="string" OnClick="@(() => SelectRole(role))">
                        <MudText>@role</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>
