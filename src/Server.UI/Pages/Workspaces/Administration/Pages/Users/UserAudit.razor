@page "/pages/workspace/administration/users/useraudit"

@using Cfo.Cats.Application.Features.Identity.DTOs
@using Cfo.Cats.Application.Features.Identity.Specifications
@using Cfo.Cats.Server.UI.Pages.Workspaces.Administration.Components
@using Humanizer

@inherits CatsComponentBase

@attribute [Authorize(Policy= SecurityPolicies.SystemFunctionsRead)]

<PageTitle>@Title</PageTitle>

<AdministrationPageHeader />

<MudTable T="IdentityAuditTrailDto"
    ServerData="ServerReload"
    FixedHeader="true"
    Loading="@_loading"
    Hover="true"
    Striped="true"
    Dense="true"
    @ref="_table"
    RowsPerPage="@_defaultPageSize">
    <ToolBarContent>
        <MudEnumSelect 
            TEnum="IdentityAuditTrailListView" 
            ValueChanged="OnChangedListView" 
            Value="Query.ListView" 
            Dense="true" 
            Label="List View"
            Style="min-width:120px">
        </MudEnumSelect>
        <MudSpacer />
        <MudStack Row="true" AlignItems="AlignItems.Stretch" Justify="Justify.FlexEnd" Spacing="2">
            <MudEnumSelect 
                TEnum="IdentityActionType?" 
                Placeholder="Search for audit type" 
                Value="@Query.IdentityActionType" 
                Clearable="true" 
                ValueChanged="@(s => OnSearch(s))" 
                Style="min-width:140px"> 
            </MudEnumSelect>

            <MudLoadingButton 
                    Color="Color.Secondary" 
                    Variant="Variant.Filled" 
                    Loading="@_downloading" 
                    OnClick="OnExport"
                    StartIcon="@Icons.Material.Filled.CloudDownload" 
                    Size="Size.Small">
            @ConstantString.Export
            </MudLoadingButton>            
        </MudStack>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel T="IdentityAuditTrailDto" SortLabel="DateTime">@_currentDto.GetMemberDescription(x => x.DateTime)</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="IdentityAuditTrailDto" SortLabel="ActionType">@_currentDto.GetMemberDescription(x => x.ActionType)</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="IdentityAuditTrailDto" SortLabel="UserName">@_currentDto.GetMemberDescription(x => x.UserName)</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="IdentityAuditTrailDto" SortLabel="PerformedBy">@_currentDto.GetMemberDescription(x => x.PerformedBy)</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="IdentityAuditTrailDto" SortLabel="IpAddress">@_currentDto.GetMemberDescription(x => x.IpAddress)</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@_currentDto.GetMemberDescription(x => x.DateTime)">@context.DateTime</MudTd>
        <MudTd DataLabel="@_currentDto.GetMemberDescription(x => x.ActionType)">
            @if (context.ActionType is not null)
            {
                @context.ActionType.Value.Humanize()
            }
        </MudTd>
        <MudTd DataLabel="@_currentDto.GetMemberDescription(x => x.UserName)">@context.UserName</MudTd>
        <MudTd DataLabel="@_currentDto.GetMemberDescription(x => x.PerformedBy)">@context.PerformedBy</MudTd>
        <MudTd DataLabel="@_currentDto.GetMemberDescription(x => x.IpAddress)">@context.IpAddress</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@ConstantString.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@ConstantString.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@([10, 15, 30, 50])" />
    </PagerContent>
</MudTable>