@page "/pages/workspace/deliverymanagement/pathway-plan-reviews"
@inherits ProviderDashboardBase
@attribute [Authorize(Policy = SecurityPolicies.AuthorizedUser)]

@using Cfo.Cats.Server.UI.Components.Dashboard
@using Cfo.Cats.Server.UI.Pages.Workspaces.DeliveryManagement.Components

<DeliveryManagementPageHeader />

<PathwayPlanReviewDashboardComponent UserId="@EffectiveUserId"
                                     TenantId="@EffectiveTenantId"
                                     @key="@SelectionKey"
                                     VisualMode="@VisualMode"
                                     ShowOverdueOnly="@_showOverdueOnly"
                                     ParticipantLocationId="@(_participantLocationId == 0 ? null : _participantLocationId)"
                                     ReviewLocationId="@(_reviewLocationId == 0 ? null : _reviewLocationId)"
                                     ReviewReason="@_reviewReason"
                                     Keyword="@_keyword">
    <ToolbarContent>
    <MudSwitch T="bool" Value="VisualMode" ValueChanged="OnVisualModeChanged" Color="Color.Info" Label="Visual Mode" />
    <MudTextField T="string" Value="@_keyword" Placeholder="@ConstantString.Search"
                  ValueChanged="@OnSearchChanged" Clearable="true" ShrinkLabel="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Adornment="Adornment.Start"
                  AdornmentColor="Color.Secondary" />
    <MudSpacer />

    <MudSwitch T="bool" Value="_showOverdueOnly" Color="Color.Info"
               ValueChanged="OnShowOverdueOnlyChanged" Label="Reviewed 3+ months ago" />

    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@ShowParticipantLocationDialog"
               EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        @(_participantLocationName ?? "All Participant Locations")
    </MudButton>

    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@ShowReviewLocationDialog"
               EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        @(_reviewLocationName ?? "All Review Locations")
    </MudButton>

    <MudMenu Size="Size.Small" Variant="Variant.Text"
             Label="@ReviewReasonLabel"
             EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        <MudMenuItem OnClick="@(() => OnReviewReasonChanged(null))">All Review Reasons</MudMenuItem>
        @foreach (var reason in ReviewReasonOptions)
        {
            <MudMenuItem OnClick="@(() => OnReviewReasonChanged(reason.Value))">@ReviewReasonText(reason)</MudMenuItem>
        }
    </MudMenu>

    @if (CanFilter)
    {
        <ProviderDashboardFilter CurrentUser="CurrentUser"
                                 SelectedTenantId="@SelectedTenantId"
                                 SelectedUserId="@SelectedUserId"
                                 TenantSelected="OnTenantSelectedWithSave"
                                 UserSelected="OnUserSelectedWithSave"
                                 ClearRequested="ClearSearch"
                                 ShowClear="false" />
    }

    <MudTooltip Text="Clear search parameters">
        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Clear" OnClick="@ClearSearch" />
    </MudTooltip>
    </ToolbarContent>
</PathwayPlanReviewDashboardComponent>
