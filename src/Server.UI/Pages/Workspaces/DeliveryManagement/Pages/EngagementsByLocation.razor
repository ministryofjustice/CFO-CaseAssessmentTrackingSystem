@page "/pages/workspace/deliverymanagement/engagements"
@inherits CatsComponentBase
@attribute [Authorize(Policy = SecurityPolicies.AuthorizedUser)]

@using ApexCharts
@using Cfo.Cats.Application.Features.Participants.DTOs
@using Cfo.Cats.Server.UI.Pages.Dashboard.Components
@using Cfo.Cats.Server.UI.Pages.Workspaces.DeliveryManagement.Components

<DeliveryManagementPageHeader />

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
    <MudText Typo="Typo.body1">
        This dashboard groups @( _isTenantLevel ? "every participant in your tenant" : "the participants assigned to you" )
        by the <strong>location at which they last engaged</strong>, split by engagement category.
    </MudText>
</MudAlert>

<MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">

    @if (_visualMode is false && _data is not null)
    {
        <MudPagination Rectangular="true"
                       Variant="Variant.Text"
                       Selected="@(_currentTablePage + 1)"
                       SelectedChanged="OnPageChanged"
                       Count="@_data.Details.TotalPages"
                       MiddleCount="2"
                       BoundaryCount="1"
                       Size="MudBlazor.Size.Small" />

        <MudText>@_data.Details.TotalItems records</MudText>
    }

    <MudSwitch T="bool" Value="_visualMode" ValueChanged="OnVisualModeChanged" Color="Color.Info" Label="Visual Mode" />

    <MudSpacer />
    
    <MudMenu Size="MudBlazor.Size.Small" 
             Variant="Variant.Text" 
             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
             Label="@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Query.Month)">
        @foreach (var month in Enumerable.Range(1, 12))
        {
            <MudMenuItem OnClick="@(() => OnMonthChanged(month))">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</MudMenuItem>
        }
    </MudMenu>

    <MudMenu Size="MudBlazor.Size.Small" 
             Variant="Variant.Text" 
             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
             Label="@Query.Year.ToString()">
        @foreach (var year in Enumerable.Range(2024, DateTime.Now.Year - 2023))
        {
            <MudMenuItem Label="@year.ToString()" OnClick="@(() => OnYearChanged(year))">@year</MudMenuItem>
        }
    </MudMenu>
    
    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="@ShowLocationDialog"
               EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        @(_selectedLocationId == 0 ? "All Locations" : _locations[_selectedLocationId])
    </MudButton>

    <MudMenu Size="MudBlazor.Size.Small" Variant="Variant.Text"
             Label="@(_selectedEngagementType == string.Empty ? "All Categories" : _selectedEngagementType)"
             EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        <MudMenuItem OnClick="@(() => OnEngagementTypeChanged(string.Empty))">All Categories</MudMenuItem>
        @foreach (var type in _engagementTypes)
        {
            <MudMenuItem OnClick="@(() => OnEngagementTypeChanged(type))">@type</MudMenuItem>
        }
    </MudMenu>

    <MudMenu Size="MudBlazor.Size.Small" Variant="Variant.Text"
             Label="@(_selectedLocationType == string.Empty ? "All Location Types" : _selectedLocationType)"
             EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
        <MudMenuItem OnClick="@(() => OnLocationTypeChanged(string.Empty))">All Location Types</MudMenuItem>
        @foreach (var locationType in _locationTypes)
        {
            <MudMenuItem OnClick="@(() => OnLocationTypeChanged(locationType))">@locationType</MudMenuItem>
        }
    </MudMenu>

    @if (_canFilterTenant)
    {
        <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Text" OnClick="@ShowTenantDialog"
                   EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
            @(_selectedTenantName ?? "All Tenants")
        </MudButton>
    }

    <MudTooltip Text="Clear search parameters">
        <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Clear" OnClick="@ClearSearch" />
    </MudTooltip>

    <MudButton Size="MudBlazor.Size.Small" Variant="Variant.Filled" Color="Color.Info"
               StartIcon="@Icons.Material.Filled.Refresh" OnClick="@OnRefresh">
        @ConstantString.Refresh
    </MudButton>

    <MudLoadingButton Color="Color.Secondary" Variant="Variant.Filled" Loading="@_downloading"
                      OnClick="@OnExport" StartIcon="@Icons.Material.Filled.CloudDownload" Size="MudBlazor.Size.Small">
        @ConstantString.Export
    </MudLoadingButton>

</MudStack>

@if (_loading)
{
    <LoadingCard Title="Engagements by Location" />
}
else if (_data is null)
{
    <MudAlert Severity="Severity.Warning">Unable to load the engagements breakdown.</MudAlert>
}
else if (_data.Records.Length == 0)
{
    <MudAlert Severity="Severity.Info">No engagements match the current filters.</MudAlert>
}
else
{
    @if (_visualMode)
    {
        <div style="overflow: visible; margin-bottom: 120px;">
            <ApexChart TItem="EngagementLocationCategoryCountDto" Options="_options" Height="600">
                @foreach (var category in GetCategories())
                {
                    <ApexPointSeries TItem="EngagementLocationCategoryCountDto"
                                     Name="@category"
                                     Items="GetCategorySeriesItems(category)"
                                     XValue="@(x => x.LocationName)"
                                     YValue="@(x => x.Count)"
                                     SeriesType="SeriesType.Bar"
                                     Color="@EngagementLocationCategoryCountDto.GetCategoryColour(category)"
                                     ShowDataLabels />
                }
            </ApexChart>
        </div>
    }
    else
    {
        <MudTable @ref="_table" ServerData="ServerReload" Hover="true" Striped="true"
                    @bind-CurrentPage="_currentTablePage" RowsPerPage="Query.PageSize"
                    Class="mt-4" Dense="true">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="FullName">Participant</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="CurrentLocationName">Current Location</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="EngagedAtLocation">Engaged at Location</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="EngagedAtLocationType">Engaged at Location Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="Category">Category</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="EngagedWith">Engaged With</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParticipantEngagementDto" SortLabel="EngagedOn">Engaged On</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Participant">
                    <MudStack Spacing="0">
                        <MudText>@context.FullName</MudText>
                        <MudLink Typo="Typo.body1" Href=@($"/pages/workspace/participants/{context.ParticipantId}?from=engagements-by-location")>
                            @context.ParticipantId
                        </MudLink>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Current Location">@context.CurrentLocationName</MudTd>
                <MudTd DataLabel="Engaged at Location">@context.EngagedAtLocationName</MudTd>
                <MudTd DataLabel="Engaged at Location Type">@context.EngagedAtLocationType</MudTd>
                <MudTd DataLabel="Category">
                    @if (context.HasEngaged)
                    {
                        <MudTooltip Text="@context.Description">
                            <MudChip T="string" Size="MudBlazor.Size.Small">@context.Category</MudChip>
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd DataLabel="Engaged With">@context.EngagedWithDisplayName</MudTd>
                <MudTd DataLabel="Engaged On">
                    @if (context.HasEngaged)
                    {
                        <MudText>@context.EngagedOn?.ToString("d")</MudText>
                    }
                    else
                    {
                        <MudText>Never</MudText>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@ConstantString.NoRecords</MudText>
            </NoRecordsContent>
        </MudTable>
    }
}
