@page "/pages/workspace/deliverymanagement/payments"
@attribute [Authorize(Roles = $"{RoleNames.SystemSupport}, {RoleNames.Finance}")]

@using Cfo.Cats.Server.UI.Pages.Workspaces.DeliveryManagement.Components
@using Cfo.Cats.Server.UI.Pages.Workspaces.DeliveryManagement.Components.Payments

<DeliveryManagementPageHeader />

@if (_noAccessToContracts)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-3">
        <MudStack>
            Performance based dashboards are coming soon
        </MudStack>
    </MudAlert>
}
else
{

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
        <MudItem xs="12" md="3">
            <MudSwitch @bind-Value="VisualMode" Label="Visual Mode" Color="Color.Info" />
        </MudItem>
        <MudSpacer />

        <MudMenu Size="MudBlazor.Size.Small" 
                Variant="Variant.Text" 
                EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                Label="@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Month)">
            @foreach (var month in Enumerable.Range(1, 12))
            {
                <MudMenuItem OnClick="@(() => OnMonthChanged(month))">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</MudMenuItem>
            }
        </MudMenu>

        <MudMenu Size="MudBlazor.Size.Small" 
                Variant="Variant.Text" 
                EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                Label="@Year.ToString()">
            @foreach (var year in Enumerable.Range(2024, DateTime.Now.Year - 2023))
            {
                <MudMenuItem Label="@year.ToString()" OnClick="@(() => OnYearChanged(year))">@year</MudMenuItem>
            }
        </MudMenu>        

        <MudMenu Size="MudBlazor.Size.Small"
            Variant="Variant.Text"
            EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
            Label="@(SelectedContract is null ? "Contract" : SelectedContract.Name )">
                @foreach(var c in ContractService.GetVisibleContracts(CurrentUser.TenantId!))
                {
                    <MudMenuItem Label="@c.Name" OnClick="@(() => OnContractChanged(c))" />
                }
        </MudMenu>

        <MudTooltip Text="Clear search parameters">
            <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Clear" OnClick="ClearSearch" />
        </MudTooltip>

    </MudStack>

    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
        Figures are subject to change following data verification checks.
    </MudAlert>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
        <MudTabPanel text="Enrolments">
            <EnrolmentPayments Month="@Month" Year="@Year" @key="@($"{Month}-{Year}-{SelectedContract?.Id}-Enrolments")" Contract="@SelectedContract" DataView="@(VisualMode == false)" />
        </MudTabPanel>
        <MudTabPanel Text="Inductions">
            <InductionPayments Month="@Month" Year="@Year" @key="@($"{Month}-{Year}-{SelectedContract?.Id}-Inductions")" Contract="@SelectedContract" DataView="@(VisualMode == false)" />
        </MudTabPanel>
        <MudTabPanel Text="Support &amp; Referral">
            <SupportAndReferral Month="@Month" Year="@Year" @key="@($"{Month}-{Year}-{SelectedContract?.Id}-SupportAndReferral")" Contract="@SelectedContract" DataView="@(VisualMode == false)" />
        </MudTabPanel>
        <MudTabPanel Text="Activities">
            <ActivityPayments Month="@Month" Year="@Year" @key="@($"{Month}-{Year}-{SelectedContract?.Id}-Activities")" Contract="@SelectedContract" DataView="@(VisualMode == false)" />
        </MudTabPanel>
        <MudTabPanel Text="Education &amp; Training">
            <EducationPayments Month="@Month" Year="@Year" @key="@($"{Month}-{Year}-{SelectedContract?.Id}-Education")" Contract="@SelectedContract" DataView="@(VisualMode == false)" />
        </MudTabPanel>
        <MudTabPanel Text="Employment">
            <EmploymentPayments Month="@Month" Year="@Year" @key="@($"{Month}-{Year}-{SelectedContract?.Id}-Employment")" Contract="@SelectedContract" DataView="@(VisualMode == false)" />
        </MudTabPanel>
    </MudTabs>
}
