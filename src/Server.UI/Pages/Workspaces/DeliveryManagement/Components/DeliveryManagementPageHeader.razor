@using Cfo.Cats.Server.UI.Pages.Workspaces.DeliveryManagement.Services
@using Cfo.Cats.Server.UI.Services.Navigation

<PageHeader Title="Provider" 
            Items="@_breadcrumbs" />

@code
{
    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnParametersSet()
    {
        _breadcrumbs = BuildBreadcrumbs();
    }

    private IReadOnlyList<BreadcrumbItem> BuildBreadcrumbs()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var trail = WorkspaceRegistry.TrailFor(Workspace.DeliveryManagement, uri.AbsolutePath);

        List<BreadcrumbItem> crumbs = trail.Items.Select(link => link.AsMudBreadcrumb()).ToList();

        // enrolments/pqa/{id} and activities/pqa/{id} sit beneath their PQA list
        if (trail.RemainingSegments.Length > 0)
        {
            var current = trail.Items[^1].Href;
            if (current == DeliveryManagementLinks.EnrolmentsPqa.Href)
            {
                crumbs.Add(new BreadcrumbItem("Enrolment", href: Navigation.Uri));
            }
            else if (current == DeliveryManagementLinks.ActivitiesPqa.Href)
            {
                crumbs.Add(new BreadcrumbItem("Activity", href: Navigation.Uri));
            }
        }

        return crumbs;
    }
}
