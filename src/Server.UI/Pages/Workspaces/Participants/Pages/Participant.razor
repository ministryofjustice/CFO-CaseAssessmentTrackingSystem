@page "/pages/workspace/participants/{id}"
@inherits CatsComponent<ParticipantSummaryDto>
@attribute [Authorize(Policy = SecurityPolicies.AuthorizedUser)]

@using Cfo.Cats.Server.UI.Pages.Workspaces.Participants.Components
@using Cfo.Cats.Server.UI.Pages.Workspaces.Performance.Components
@using Cfo.Cats.Server.UI.Pages.Participants.Components
@using Cfo.Cats.Server.UI.Pages.Participants.Components.DMS
@using Cfo.Cats.Server.UI.Pages.Participants.Components.Histories
@using Cfo.Cats.Application.Features.Participants.DTOs

<style>
    .primary-tabs .mud-tabs-toolbar .mud-tooltip-root .mud-tab-active {}
</style>

  <ParticipantsPageHeader />

  @if(ErrorMessage is not null)
  {
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        @ErrorMessage
    </MudAlert>
  }

  @if (Data is not null)
    {
        <CascadingValue Value="Data">
        <CascadingValue Value="ParticipantCascadingDetails" Name="ParticipantDetails" IsFixed="true">
            <MudPaper Class="pa-2 ma-2" Style="min-height: 90vh;" Elevation="3">
                @if (Data.PostLicenceCaseClosureEnd.HasValue)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="true" Class="my-2">@string.Format(_notActiveInFeedAlertMessage, Data.PostLicenceCaseClosureEnd.Value.ToShortDateString())</MudAlert>
                }
                <MudGrid Class="pa-1" Justify="Justify.FlexStart">
                    <MudItem xs="12">

                        <MudStack Row="true" Spacing="2" Reverse="false" Breakpoint="Breakpoint.SmAndDown" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Wrap="Wrap.Wrap"   >
                            <MudText Typo="Typo.body2">Participant</MudText>
                            <MudText Typo="Typo.body1">@Data.ParticipantName</MudText>
                            <MudDivider Vertical="true" FlexItem="true"/>
                            <MudText Typo="Typo.body2">Ref</MudText>
                            <MudText Typo="Typo.body1">@Data.Id</MudText>
                            <MudDivider Vertical="true" FlexItem="true"/>
                            <MudText Typo="Typo.body2">Status</MudText>
                            <MudText Typo="Typo.body1">@Data.EnrolmentStatus.Name</MudText>
                            <MudDivider Vertical="true" FlexItem="true"/>
                            <MudText Typo="Typo.body2" >Assigned To</MudText>
                            <MudText Typo="Typo.body1">@($"{Data.OwnerName} ({Data.TenantName}) ")</MudText>
                            <MudDivider Vertical="true" FlexItem="true"/>
                            <MudText Typo="Typo.body2" >Location</MudText>
                            <MudText Typo="Typo.body1">@Data.Location</MudText>
                        </MudStack>
                    </MudItem>
                </MudGrid>

                @if (Data.EnrolmentStatus != EnrolmentStatus.IdentifiedStatus)
                {
                    <MudStack Row="true" Justify="Justify.FlexStart">
                        <ParticipantActionMenu OnUpdate="() => RefreshAsync()"/>
                        <MudDivider Vertical="true" FlexItem="true" />
                        <RagBar ParticipantId="@Id" AssessmentId="@Data.Assessments.OrderByDescending(l => l.Created).FirstOrDefault()?.AssessmentId" />
                    </MudStack>
                    
                   
                    @if (ShowRightToWorkWarning())
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="true" Class="my-2">@_rightToWorkAlertMessage</MudAlert>
                    }

                    <MudTabs Class="primary-tabs mt-2" Outlined="true" Color="Color.Info" Border="true" Style="height: 100%;">

                        <MudTabPanel Text="Case Summary">
                            <MudTabs Outlined="true" Border="true" Class="mt-2">
                                <MudTabPanel Text="Case Summary">
                                    <CaseSummary />
                                </MudTabPanel>
                                <MudTabPanel Text="Status History">
                                    <MudText> </MudText>
                                    <ParticipantActiveHistory ParticipantId="@Id" />
                                </MudTabPanel>

                                <MudTabPanel Text="Location History">                                    
                                    <LocationHistory ParticipantId="@Id" />
                                </MudTabPanel>
                            </MudTabs>
                        </MudTabPanel>

                        <MudTabPanel Text="About">
                            <CaseAbout ParticipantId="@Id" ParticipantIsActive="@Data.IsActive" />
                        </MudTabPanel>
                        <MudTabPanel Text="Inductions">
                            <Inductions ParticipantId="@Id" ParticipantIsActive="@Data.IsActive" />
                        </MudTabPanel>
                        <MudTabPanel Text="Sentence Information">
                            <CaseSentenceInformation ParticipantId="@Id" ParticipantIsActive="@Data.IsActive" />
                            <ExternalData ParticipantId="@Id" ConsentStatus="@Data.ConsentStatus" />
                        </MudTabPanel>
                        <MudTabPanel Text="Risk">
                            <CaseRisk ParticipantId="@Id" />
                        </MudTabPanel>
                        <MudTabPanel Text="Assessments">
                            <CaseAssessment ParticipantId="@Id" ConsentDate="@Data.DateOfFirstConsent"/>
                        </MudTabPanel>
                        <MudTabPanel Text="Pathway Plan">
                             <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                 <MudSwitch T="bool" @bind-Value="_pathwaySummaryView" Color="Color.Secondary" ThumbIcon="@Icons.Material.Filled.Summarize">
                                    Summary View
                                 </MudSwitch>
                                 <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                                     <MudButton StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="@ExpandAllPathwayPlan">Expand All</MudButton>
                                     <MudButton StartIcon="@Icons.Material.Filled.UnfoldLess" OnClick="@CollapseAllPathwayPlan">Collapse All</MudButton>
                                 </MudButtonGroup>
                             </MudStack>
                             @if(_pathwaySummaryView)
                             {
                                <MudStack Spacing="3">
                                    <MudText Typo="Typo.h4">
                                        Pathway Plan
                                    </MudText>
                                    <OutcomeQualityDipSamplePathwayPlanComponent @ref="_summaryObjectives" ParticipantId="@Data.Id" />
                                    <MudText Typo="Typo.h4">
                                        Reviews
                                    </MudText>
                                    <PathwayPlanReviewHistory @ref="_summaryReviewHistory" ParticipantId="@Data.Id"/>   
                                </MudStack>
                                
                             }
                             else
                             {
                                <CasePathwayPlan @ref="_casePathwayPlan"/>
                             }
                        </MudTabPanel>
                        <MudTabPanel Text="PRI">
                            <CasePRI ParticipantId="@Id" OnUpdate="() => RefreshAsync()" />
                        </MudTabPanel>
                        <MudTabPanel Text="Bio">
                            <CaseBio ParticipantId="@Id" />
                        </MudTabPanel>
                        <MudTabPanel Text="Documents">
                            <CaseDocuments ParticipantId="@Id" />
                        </MudTabPanel>
                        <MudTabPanel Text="Notes">
                            <CaseNotes ParticipantId="@Id" AllowAddNote="@Data.IsActive" />
                        </MudTabPanel>
                        <MudTabPanel Text="Timeline">
                            <CaseTimeline />
                        </MudTabPanel>

                        <AuthorizeView Policy="@SecurityPolicies.ServiceDeskManagement">
                            <MudTabPanel Text="Audit">
                                <ParticipantAudit Id="@Id" />
                            </MudTabPanel>
                        </AuthorizeView>
                    
                    </MudTabs>
                }
            </MudPaper>
        </CascadingValue>
        </CascadingValue>
    }