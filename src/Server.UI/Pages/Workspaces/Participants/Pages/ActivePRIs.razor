@page "/pages/workspace/participants/pre-release-inventory"
@inherits CatsComponentBase
@attribute [Authorize(Policy = SecurityPolicies.AuthorizedUser)]

@using Cfo.Cats.Server.UI.Pages.Workspaces.Participants.Components
@using Cfo.Cats.Application.Features.PRIs.DTOs
@using Humanizer

@inject ICurrentUserService CurrentUser

<ParticipantsPageHeader />

<PRIFilterBar 
    Query="@Query"
    PriTypeFilter="@_priTypeFilter"
    TotalPages="@_totalPages"
    TotalItems="@_totalItems"
    Tabular="@Tabular"
    IsDownloading="@_downloading"
    Users="@_users"
    Locations="@_locations"
    OnSearchChanged="@OnSearch"
    OnRefresh="@OnRefresh"
    OnExport="@OnExport"
    OnCreatePriCode="@CreatePriCode"
    OnTabularChanged="@TabularChanged"
    OnSetPriType="@SetPriType"
    OnShowCustodyWorkerDialog="@ShowCustodyWorkerDialog"
    OnShowCommunityWorkerDialog="@ShowCommunityWorkerDialog"
    OnShowRegionDialog="@ShowRegionDialog"
    OnActiveStatusChanged="@OnActiveStatusChanged"
    OnSortBy="@(new EventCallback<string>(this, SortBy))"
    OnClearSearch="@ClearSearch" />

@if (Tabular)
{
    <MudTable Dense="true" T="PRIPaginationDto" Items="@_data" Hover="true" Striped="true" Loading="@_loading">
        <HeaderContent>
            <MudTh>Actions</MudTh>
            <MudTh>Participant</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Custody Support Worker</MudTh>
            <MudTh>Community Support Worker</MudTh>
            <MudTh>Expected Release Region</MudTh>
            <MudTh>Expected Release Date</MudTh>
            <MudTh>Actual Release Date</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Size="Size.Small"
                         Dense="true"
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                    <MudMenuItem OnClick="@(()=> ViewParticipant(context))">
                        @ConstantString.ViewParticipant
                    </MudMenuItem>

                    @if(context.ParticipantIsActive)
                    {
                        @if (context.ActualReleaseDate == null)
                        {
                            <MudMenuItem OnClick="@(()=> AddActualReleaseDate(context))">
                                @ConstantString.AddActualReleaseDate
                            </MudMenuItem>
                        }
                        else
                        {
                            if (CurrentUser.UserId == context.AssignedTo)
                            {
                                <MudMenuItem OnClick="@(()=> CompletePri(context))">
                                    @ConstantString.CompletePRI
                                </MudMenuItem>
                            }
                        }
                        <MudMenuItem OnClick="@(()=> AbandonPri(context))">
                            @ConstantString.AbandonPRI
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTd>
            <MudTd>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.ParticipantName</MudText>
                    <MudText Typo="Typo.body1">@context.ParticipantId</MudText>
                </div>
            </MudTd>
            <MudTd>
                @if(context.ParticipantIsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Cancel">Inactive</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body1">@UserService.GetDisplayName(context.CreatedBy!)</MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body1">@UserService.GetDisplayName(context.AssignedTo!)</MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body1">@context.ExpectedReleaseRegion?.Name</MudText>
            </MudTd>
            <MudTd>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.ExpectedReleaseDate</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">
                        @(context.ExpectedReleaseDate == DateOnly.FromDateTime(DateTime.Today) ? "today" : context.ExpectedReleaseDate.Humanize())
                    </MudText>
                </div>
            </MudTd>
            <MudTd>
                <div class="d-flex flex-column">
                    @if(context.ActualReleaseDate is not null)
                    {
                        <MudText Typo="Typo.body1">@context.ActualReleaseDate</MudText>
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">
                            @(context.ActualReleaseDate == DateOnly.FromDateTime(DateTime.Today) ? "today" : context.ActualReleaseDate.Humanize())
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">Not set</MudText>
                    }
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    @if (_data is { Length: > 0 })
    {
        <MudStack Class="mt-4" Spacing="2">
            @foreach (var item in _data)
            {
                <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="2">
                    <!-- Header: Name, ID and Status -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 500">@item.ParticipantName</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">(@item.ParticipantId)</MudText>
                        @if(item.ParticipantIsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Active</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Cancel">Inactive</MudChip>
                        }
                    </MudStack>
                        
                    <MudGrid Spacing="2">
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Custody Support Worker</MudText>
                            <MudText Typo="Typo.body2">@UserService.GetDisplayName(@item.CreatedBy!)</MudText>
                        </MudItem>
                            
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Community Support Worker</MudText>
                            <MudText Typo="Typo.body2">@UserService.GetDisplayName(@item.AssignedTo!)</MudText>
                        </MudItem>
                            
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Expected Release Region</MudText>
                            <MudText Typo="Typo.body2">@item.ExpectedReleaseRegion!.Name</MudText>
                        </MudItem>
                        
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Expected Release Date</MudText>
                            <MudText Typo="Typo.body2">@item.ExpectedReleaseDate</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @(item.ExpectedReleaseDate == DateOnly.FromDateTime(DateTime.Today) ? "today" : item.ExpectedReleaseDate.Humanize())
                            </MudText>
                        </MudItem>
  
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Actual Release Date</MudText>
                            @if(item.ActualReleaseDate is not null)
                            {
                                <MudText Typo="Typo.body2">@item.ActualReleaseDate</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @(item.ActualReleaseDate == DateOnly.FromDateTime(DateTime.Today) ? "today" : item.ActualReleaseDate.Humanize())
                                </MudText>
                        
                       
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Not set</MudText>
                            }
                        </MudItem>
                    </MudGrid>
                </MudStack>
                 <MudDivider Class="mt-3 mb-2" />
                    
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(()=> ViewParticipant(item))">
                            @ConstantString.ViewParticipant
                        </MudButton>
                        
                        @if(item.ParticipantIsActive)
                        {
                            @if (item.ActualReleaseDate == null)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CalendarToday" OnClick="@(()=> AddActualReleaseDate(item))">
                                    @ConstantString.AddActualReleaseDate
                                </MudButton>
                            }
                            else
                            {
                                @if (CurrentUser.UserId == item.AssignedTo)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="@(()=> CompletePri(item))">
                                        @ConstantString.CompletePRI
                                    </MudButton>
                                }
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(()=> AbandonPri(item))">
                                @ConstantString.AbandonPRI
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">No PRIs match the current filters.</MudAlert>
    }
}