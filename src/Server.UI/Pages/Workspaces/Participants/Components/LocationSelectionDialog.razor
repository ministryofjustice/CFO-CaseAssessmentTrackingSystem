<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudList T="string">
            <MudListItem T="string" OnClick="@(() => SelectLocation(null))">
                <MudText>All Locations</MudText>
            </MudListItem>
            @foreach (var location in Locations.OrderBy(l => l.Value))
            {
                <MudListItem T="string" OnClick="@(() => SelectLocation(location.Key))">
                    <MudText>@location.Value</MudText>
                </MudListItem>
            }
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public IDictionary<int, string> Locations { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "Select Location";

    void SelectLocation(int? locationId)
    {
        MudDialog.Close(DialogResult.Ok(locationId));
    }

    void Cancel()
    {
        MudDialog.Cancel();
    }
}
