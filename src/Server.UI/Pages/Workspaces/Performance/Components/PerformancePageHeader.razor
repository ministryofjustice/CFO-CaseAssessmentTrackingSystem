@using Cfo.Cats.Server.UI.Pages.Workspaces.Performance.Services
@using Cfo.Cats.Server.UI.Services.Navigation

<PageHeader Title="Performance Management"
            Items="@_breadcrumbs" />

@code
{
    // Optional friendly label for the dip-sample crumb. The sample's display name
    // ("{ContractName} ({Period})") is loaded from server data, so pages that have it
    // supply it here; the rest of the trail is derived from the current URL.
    [Parameter]
    public string? SampleLabel { get; set; }

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnParametersSet()
    {
        _breadcrumbs = BuildBreadcrumbs();
    }

    private IReadOnlyList<BreadcrumbItem> BuildBreadcrumbs()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var trail = WorkspaceRegistry.TrailFor(Workspace.Performance, uri.AbsolutePath);

        List<BreadcrumbItem> crumbs = trail.Items.Select(link => link.AsMudBreadcrumb()).ToList();

        // The dynamic part of the path under the dip sampling page:
        // {sampleId}/{participantId}
        var isDipSampling = trail.Items[^1].Href == PerformanceLinks.OutcomeQualityDipSamples.Href;
        var remaining = trail.RemainingSegments;

        if (isDipSampling && remaining.Length >= 1 && Guid.TryParse(remaining[0], out var sampleId))
        {
            var sample = PerformanceLinks.OutcomeQualityDipSample(sampleId);
            var sampleTitle = string.IsNullOrWhiteSpace(SampleLabel) ? sample.Title : SampleLabel;
            crumbs.Add(new BreadcrumbItem(sampleTitle, sample.Href));

            if (remaining.Length >= 2)
            {
                crumbs.Add(PerformanceLinks.OutcomeQualityDipSampleParticipant(sampleId, remaining[1]).AsMudBreadcrumb());
            }
        }

        return crumbs;
    }
}
