@using Cfo.Cats.Application.Common.Validators

@if (Status != DipSampleStatus.Verified)
{
    <MudAlert Severity="Severity.Info">
        This information is now readonly because the sample is at the @Status.Name stage.
    </MudAlert>
}

<MudForm @ref="_form" Model="Command" Validation="@(Validator.ValidateValue(Command))" Class="ma-2" ReadOnly="ReadOnly">
    <MudGrid>
        <MudItem xs="12">
            <MudStack Row="true" Justify="Justify.FlexStart" Spacing="4" AlignItems="AlignItems.Center" Class="mb-1">
                <MudText Typo="Typo.subtitle1">
                    @Command.GetMemberDescription(x => x.Comments)
                </MudText>
                @if (!ReadOnly && !string.IsNullOrWhiteSpace(CpmComments))
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudButton Color="Color.Secondary" 
                                   Variant="Variant.Filled" 
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Style="width: fit-content;"
                                   OnClick="@CopyFromVerification">
                            Copy from Verification
                        </MudButton>
                        <MudTooltip Text="Click to view Verification comments">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                          Size="Size.Small" 
                                          Color="Color.Info"
                                          OnClick="@(() => _showCpmComments = !_showCpmComments)" />
                        </MudTooltip>
                    </MudStack>
                }
            </MudStack>
            <MudStack Spacing="2">
                @if (!ReadOnly && !string.IsNullOrWhiteSpace(CpmComments) && _showCpmComments)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" NoIcon="false">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Verification Comments (CPM)</MudText>
                            <MudText Typo="Typo.body1">@CpmComments</MudText>
                        </MudStack>
                    </MudAlert>
                }
                <MudTextField @bind-Value="@Command.Comments"
                              For="@(() => Command.Comments)"
                              Variant="Variant.Outlined"
                              Lines="12"
                              MaxLines="30"
                              FullWidth="true"
                              MaxLength=@ValidationConstants.NotesLength_Outcomes
                              Counter=@ValidationConstants.NotesLength_Outcomes
                              Immediate="true">
                </MudTextField>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudAvatar Size="Size.Medium" Color="@Color.Primary">
                    ?
                </MudAvatar>
                <MudText Typo="Typo.subtitle1">
                    @Command.GetMemberDescription(x => x.ComplianceAnswer)
                </MudText>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="4" Class="d-flex align-center">
            <MudRadioGroup @bind-Value="Command.ComplianceAnswer" For="@(() => Command.ComplianceAnswer)">
                <MudRadio Value="@ComplianceAnswer.Compliant">@ComplianceAnswer.Compliant.Name</MudRadio>
                <MudRadio Value="@ComplianceAnswer.NotCompliant">@ComplianceAnswer.NotCompliant.Name</MudRadio>
                @if (Command.ComplianceAnswer.IsAuto)
                {
                    <MudRadio Value="@ComplianceAnswer.AutoCompliant">@ComplianceAnswer.AutoCompliant.Name</MudRadio>
                    <MudRadio Value="@ComplianceAnswer.AutoNotCompliant">@ComplianceAnswer.AutoNotCompliant.Name</MudRadio>
                }
            </MudRadioGroup>
        </MudItem>

        <MudItem xs="12">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Disabled="@ReadOnly" OnClick="@OnSubmit">Submit</MudButton>
        </MudItem>
    </MudGrid>
</MudForm>