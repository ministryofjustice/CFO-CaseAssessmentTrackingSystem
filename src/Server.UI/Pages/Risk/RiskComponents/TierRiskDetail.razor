@using Cfo.Cats.Application.Features.HmppsExternalApi.DTOs
@using Humanizer
@using static Cfo.Cats.Server.UI.Pages.Risk.RiskComponents.HmppsRiskDisplay
@inherits CatsComponent<TierDetailsDto>

@if (Loading)
{
    <MudProgressCircular Class="mt-4" Indeterminate="true" Size="Size.Small" />
}
else if (ErrorMessage is not null)
{
    <MudAlert Class="mt-4" Severity="Severity.Error"><b>Tier:</b> @ErrorMessage</MudAlert>
}
else if (Data is not null)
{
    var registrations = Data.Data?.DeliusInputs?.Registrations;
    var predictors = Data.Data?.OasysInputs?.Predictors;

    <MudGrid Class="mt-2" Spacing="3">
        <MudItem xs="12" md="8">
            <MudCard Outlined="true" Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Risk predictor scores</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="ShowCalculation">View tier calculation</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    @if (predictors?.Output is null)
                    {
                        <MudText Typo="Typo.body2">There are no OASys risk predictor scores.</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                @foreach (var (label, predictor) in PredictorItems(predictors.Output).Where(p => p.Predictor is not null))
                                {
                                    <tr>
                                        <td>@label</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(predictor!.Band))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="@LevelColor(predictor.Band)">@Upper(predictor.Band)</MudChip>
                                            }
                                            else
                                            {
                                                <span>@NotRecorded</span>
                                            }
                                        </td>
                                        <td class="mud-text-secondary">@(predictor.Score is null ? null : $"Score {Show(predictor.Score)}")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudText Typo="Typo.caption" Class="d-block mt-2">OASys predictors completed on @Show(predictors.CompletedDate)</MudText>
                    }
                    <MudText Typo="Typo.caption" Class="d-block">Delius RSR score @Show(Data.Data?.DeliusInputs?.RsrScore), OGRS score @Show(Data.Data?.DeliusInputs?.OgrsScore)</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Outlined="true" Class="mb-3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Risk flags</MudText>
                        <MudText Typo="Typo.caption">From NDelius registrations used in the tier calculation</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr>
                                <td>ROSH registration</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(registrations?.Rosh))
                                    {
                                        <span>@NotRecorded</span>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@LevelColor(registrations.Rosh)">@Upper(registrations.Rosh)</MudChip>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>Active flags</td>
                                <td>
                                    @if (ActiveFlags.Any())
                                    {
                                        @foreach (var flag in ActiveFlags)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@flag</MudChip>
                                        }
                                    }
                                    else
                                    {
                                        <span>There are no active risk flags</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>Complexity factors</td>
                                <td>
                                    @if (registrations?.ComplexityFactors is { Count: > 0 })
                                    {
                                        @foreach (var factor in registrations.ComplexityFactors)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@Humanise(factor)</MudChip>
                                        }
                                    }
                                    else
                                    {
                                        <span>None recorded</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                    @if (InactiveFlags.Any())
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-2">Not registered: @string.Join(", ", InactiveFlags)</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-4 mb-3" Style="@($"border: 2px solid {TierCssColor}")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h4" Style="@($"color: {TierCssColor}")"><b>@(TierScore ?? "UNKNOWN")</b></MudText>
                    <MudText Typo="Typo.h6">Tier</MudText>
                    @if (IsProvisional)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Provisional</MudChip>
                    }
                </MudStack>
                <MudText Typo="Typo.body2" Class="mt-1">The level of risk and complexity involved in managing this probation case.</MudText>
                <MudText Typo="Typo.caption" Class="d-block mt-2">Last calculated @(Data.CalculationDate?.Humanize() ?? "unknown")</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 mb-3" Style="@($"border: 2px solid {(Mappa is null ? LevelCssColor(null) : "var(--mud-palette-primary)")}")">
                <MudText Typo="Typo.h6"><b>@(Mappa ?? "UNKNOWN")</b> MAPPA</MudText>
                <MudText Typo="Typo.body2">Multi-agency public protection arrangements</MudText>
            </MudPaper>
        </MudItem>

    </MudGrid>
}
else
{
    <MudAlert Class="mt-4" Severity="Severity.Info"><b>Tier:</b> No data found.</MudAlert>
}
