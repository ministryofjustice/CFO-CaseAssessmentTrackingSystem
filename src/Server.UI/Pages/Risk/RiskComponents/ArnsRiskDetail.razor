@using Cfo.Cats.Application.Features.HmppsExternalApi.DTOs
@inherits CatsComponent<RisksDto>
@using Humanizer

@if (Loading)
{
    <MudProgressCircular Class="mt-4" Indeterminate="true" Size="Size.Small" />
}
else if (ErrorMessage is not null)
{
    <MudAlert Class="mt-4" Severity="Severity.Error"><b>Risk of serious harm (ARNS):</b> @ErrorMessage</MudAlert>
}
else if (Data is not null)
{
    <MudCard Class="mt-4">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h2">Risk of Serious Harm</MudText>
                <MudChip T="string" Color="@RiskLevelColor(Data.Summary?.OverallRiskLevel ?? "Unknown")">@(Data.Summary?.OverallRiskLevel ?? "Unknown")</MudChip>
            </MudStack>
            <MudTextField Label="Assessed on" Value="@(Data.AssessedOn?.ToString("dd/MM/yyyy"))" Placeholder="Unknown" ReadOnly Class="mt-4" />
            <MudTextField Label="Who is at risk" Value="@(Data.Summary?.WhoIsAtRisk)" Placeholder="Not recorded" ReadOnly Lines="5" Class="mt-4" />
            <MudTextField Label="Nature of risk" Value="@(Data.Summary?.NatureOfRisk)" Placeholder="Not recorded" ReadOnly Lines="5" Class="mt-4" />
            <MudTextField Label="Risk imminence" Value="@(Data.Summary?.RiskImminence)" Placeholder="Not recorded" ReadOnly Lines="5" Class="mt-4" />
            <MudTextField Label="Risk increase factors" Value="@(Data.Summary?.RiskIncreaseFactors)" Placeholder="Not recorded" ReadOnly Lines="5" Class="mt-4" />
            <MudTextField Label="Risk mitigation factors" Value="@(Data.Summary?.RiskMitigationFactors)" Placeholder="Not recorded" ReadOnly Lines="5" Class="mt-4" />

            <MudText Typo="Typo.h3" Class="mt-4">Risk to self</MudText>
            <MudGrid Class="mt-1">
                @foreach (var (label, detail) in RiskToSelfItems)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="pa-3" Outlined="true">
                            <MudText Typo="Typo.body1" Class="mb-2">@label</MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudChip T="string" Size="Size.Small" Color="@RiskColor(detail?.Current)" Disabled="@(detail?.Current is null)">Current: @(detail?.Current ?? "Not recorded")</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@RiskColor(detail?.Previous)" Disabled="@(detail?.Previous is null)">Previous: @(detail?.Previous ?? "Not recorded")</MudChip>
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(detail?.CurrentConcernsText))
                            {
                                <MudText Typo="Typo.caption" Class="mt-1 d-block">Current concerns: @detail.CurrentConcernsText</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(detail?.PreviousConcernsText))
                            {
                                <MudText Typo="Typo.caption" Class="mt-1 d-block">Previous concerns: @detail.PreviousConcernsText</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <MudText Typo="Typo.h3" Class="mt-4">Other risks</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-1">
                @foreach (var (label, value) in OtherRiskItems)
                {
                    <MudChip T="string" Color="@RiskColor(value)" Disabled="@(value is null)">@label: @(value ?? "Not recorded")</MudChip>
                }
            </MudStack>

            @if (Data.Summary?.RiskInCommunity is { Count: > 0 } || Data.Summary?.RiskInCustody is { Count: > 0 })
            {
                <MudText Typo="Typo.h3" Class="mt-4">Risk by category</MudText>
                <MudSimpleTable Class="mt-1" Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>In community</th>
                            <th>In custody</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in RiskCategories)
                        {
                            <tr>
                                <td>@category.Humanize(LetterCasing.Title)</td>
                                <td>
                                    @{
                                        var communityLevel = GetRiskLevel(Data.Summary?.RiskInCommunity, category);
                                    }
                                    @if (communityLevel is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@RiskLevelColor(communityLevel)">@communityLevel</MudChip>
                                    }
                                </td>
                                <td>
                                    @{
                                        var custodyLevel = GetRiskLevel(Data.Summary?.RiskInCustody, category);
                                    }
                                    @if (custodyLevel is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@RiskLevelColor(custodyLevel)">@custodyLevel</MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudCardContent>
    </MudCard>
}
else
{
    <MudAlert Class="mt-4" Severity="Severity.Info"><b>Risk of serious harm (ARNS):</b> No data found.</MudAlert>
}
