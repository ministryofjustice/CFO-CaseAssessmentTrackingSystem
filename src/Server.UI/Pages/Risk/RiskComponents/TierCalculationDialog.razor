@using System.Globalization
@using Cfo.Cats.Application.Features.HmppsExternalApi.DTOs
@using static Cfo.Cats.Server.UI.Pages.Risk.RiskComponents.HmppsRiskDisplay

<MudDialog>
    <DialogContent>
        @{
            var calculation = Tier.Data;
            var delius = calculation?.DeliusInputs;
            var assessment = calculation?.AssessmentSummary?.Assessment;
            var predictors = calculation?.OasysInputs?.Predictors;
        }

        <MudText Typo="Typo.caption">CRN @Crn. Tier calculated @Show(Tier.CalculationDate).</MudText>

        <MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
            <MudTabPanel Text="Predictors">
                @if (predictors is null)
                {
                    <MudText Typo="Typo.body2">No OASys predictors recorded.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">Assessment type: @Show(predictors.AssessmentType)</MudText>
                    <MudText Typo="Typo.body2">Output version: @Show(predictors.OutputVersion)</MudText>
                    <MudText Typo="Typo.body2">Completed: @Show(predictors.CompletedDate)</MudText>

                    <MudSimpleTable Class="mt-2" Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Predictor</th>
                                <th>Score</th>
                                <th>Band</th>
                                <th>Static / dynamic</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (label, predictor) in TierRiskDetail.PredictorItems(predictors.Output))
                            {
                                <tr>
                                    <td>@label</td>
                                    <td>@Show(predictor?.Score)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(predictor?.Band))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="@LevelColor(predictor.Band)">@Humanise(predictor.Band)</MudChip>
                                        }
                                        else
                                        {
                                            <span>@NotRecorded</span>
                                        }
                                    </td>
                                    <td>@Show(Humanise(predictor?.StaticOrDynamic))</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="Delius inputs">
                @if (delius is null)
                {
                    <MudText Typo="Typo.body2">No Delius inputs recorded.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <tbody>
                            @foreach (var (label, value) in DeliusItems(delius))
                            {
                                <tr>
                                    <td>@label</td>
                                    <td>@value</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="OASys assessment">
                @if (calculation?.AssessmentSummary is null)
                {
                    <MudText Typo="Typo.body2">No OASys assessment recorded.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">Assessment ID: @(assessment?.Id?.ToString() ?? NotRecorded)</MudText>
                    <MudText Typo="Typo.body2">Type: @Show(assessment?.Type)</MudText>
                    <MudText Typo="Typo.body2">Status: @Show(Humanise(assessment?.Status))</MudText>
                    <MudText Typo="Typo.body2">Completed: @Show(assessment?.CompletedDate)</MudText>
                    <MudText Typo="Typo.body2">SAN indicator: @Show(assessment?.SanIndicator)</MudText>
                    <MudText Typo="Typo.body2">Ever committed sexual offence: @Show(calculation.OasysInputs?.EverCommittedSexualOffence)</MudText>

                    <MudGrid Class="mt-2">
                        @foreach (var (label, section) in AssessmentSections(calculation.AssessmentSummary))
                        {
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Outlined="true" Style="height:100%">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body1">@label</MudText>
                                        <MudChip T="string" Size="Size.Small" Disabled="@(section?.Score is null)">Score: @(section?.Score?.ToString("0.##", CultureInfo.InvariantCulture) ?? NotRecorded)</MudChip>
                                    </MudStack>
                                    @if (section is null)
                                    {
                                        <MudText Typo="Typo.body2">@NotRecorded</MudText>
                                    }
                                    else
                                    {
                                        <MudStack Row="true" Spacing="1" Class="mb-2">
                                            <MudChip T="string" Size="Size.Small" Color="@AnswerColor(section.LinkedToReOffending)">Linked to reoffending: @Show(section.LinkedToReOffending)</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="@AnswerColor(section.LinkedToHarm)">Linked to harm: @Show(section.LinkedToHarm)</MudChip>
                                        </MudStack>
                                        <MudSimpleTable Dense="true" Elevation="0">
                                            <tbody>
                                                @foreach (var (question, answer) in SectionAnswers(section))
                                                {
                                                    <tr>
                                                        <td>@question</td>
                                                        <td>@Show(answer)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>
