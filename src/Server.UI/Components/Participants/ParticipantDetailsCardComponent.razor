
@using System.Globalization
@using Cfo.Cats.Application.Features.Participants.DTOs
@using Humanizer

@inherits ParticipantComponent<ParticipantHeaderDetailsDto>

@if (Loading)
{
    <MudLoading Text="Loading"/>
}

@if (ErrorMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="Severity.Error">
        @ErrorMessage
    </MudAlert>
}

@if (Data is not null)
{
    <MudCard Style="height: 100%;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText>
                    Participant Details
                </MudText>
            </CardHeaderContent>
            
        </MudCardHeader>
     
        <MudCardContent>

            <DataList>
                <ChildContent>
                    <DataListItem Label="Date Of Birth" HelperText="@($"Age {@Data.DateOfBirth.CalculateAge()}")">
                        @Data.DateOfBirth.ToShortDateString()
                    </DataListItem>
                    <DataListItem Label="Enrolled at">
                        @Data.EnrolmentLocation
                    </DataListItem>
                    <DataListItem Label="Nationality">
                        @(Data.Nationality ?? "Not Set")
                    </DataListItem>
                    <DataListItem Label="Consent Date" HelperText="@Data.GetConsentDateHelperText()">
                        @Data.DateOfFirstConsent
                    </DataListItem>
                    <DataListItem Label="Last Data Sync" HelperText="@Data.LastSync.Humanize()" >
                        @Data.LastSync.ToShortDateString()
                    </DataListItem>
                </ChildContent>
            </DataList>
        </MudCardContent>
        <MudCardActions>

        </MudCardActions>
    </MudCard>

    
}
