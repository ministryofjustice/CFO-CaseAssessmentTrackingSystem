
@using System.Globalization
@using Cfo.Cats.Application.Features.Participants.DTOs
@using Humanizer

@inherits ParticipantComponent<ParticipantHeaderDetailsDto>

@if (Loading)
{
    <MudLoading Text="Loading"/>
}

@if (ErrorMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="Severity.Error">
        @ErrorMessage
    </MudAlert>
}

@if (Data is not null)
{
    <MudCard Style="height: 100%;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText>
                    Participant Details
                </MudText>
            </CardHeaderContent>
            
        </MudCardHeader>
     
        <MudCardContent>

            <DataList>
                <ChildContent>
                    <DataListItem Label="Date Of Birth" HelperText="@($"Age {@Data.DateOfBirth.CalculateAge()}")">
                        @Data.DateOfBirth.ToShortDateString()
                    </DataListItem>
                    <DataListItem Label="Enrolled at">
                        @Data.EnrolmentLocation
                    </DataListItem>
                    <DataListItem Label="Nationality">
                        @(Data.Nationality ?? "Not Set")
                    </DataListItem>
                    <DataListItem Label="Consent Date" HelperText="@Data.GetConsentDateHelperText()">
                        @Data.DateOfFirstConsent
                    </DataListItem>
                    <DataListItem Label="Last Data Sync" HelperText="@Data.LastSync.Humanize()" >
                        @Data.LastSync.ToShortDateString()
                    </DataListItem>
                </ChildContent>
            </DataList>

           
            @* <MudForm ReadOnly="true" Spacing="2">
            <MudTextField 
                T="DateOnly" 
                Label="Date of Birth" 
                Value="@Data.DateOfBirth"
                HelperText="@($"Age {Data.DateOfBirth.CalculateAge()}")" />
            <MudTextField Label="Enrolment Location" Value="@Data.EnrolmentLocation"  />
            <MudTextField Label="Nationality" Value="@(Data.Nationality ?? "Not Set")"/>
            <MudTextField Label="Consent Date" Value="@Data.DateOfFirstConsent"
                HelperText="@Data.GetConsentDateHelperText()" /> 
            <MudTextField Label="Last Data Sync" Value="@Data.LastSync.ToShortDateString()" HelperText="@Data.LastSync.Humanize()" />
        </MudForm> *@
        </MudCardContent>
        <MudCardActions>

        </MudCardActions>
    </MudCard>

    
}
