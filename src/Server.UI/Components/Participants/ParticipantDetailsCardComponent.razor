@using Cfo.Cats.Application.Features.Participants.DTOs
@using Humanizer

@inherits ParticipantComponent<ParticipantHeaderDetailsDto>

@if (Loading)
{
    <MudLoading Text="Loading"/>
}

@if (ErrorMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="Severity.Error">
        @ErrorMessage
    </MudAlert>
}

@if (Data is not null)
{
    <MudCard Style="height: 100%;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText>
                    Participant Details
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
     
        <MudCardContent>

            <DataList>
                <ChildContent>
                    <DataListItem Label="Date Of Birth" HelperText="@(Data.DateOfBirth is { } dob ? $"Age {dob.CalculateAge()}" : null)">
                        @(Data.DateOfBirth?.ToShortDateString() ?? "Hidden until consent is approved")
                    </DataListItem>
                    <DataListItem Label="Enrolled at">
                        <LabelActions>
                            @if (!string.IsNullOrWhiteSpace(Data.EnrolmentJustification)
                                 || !string.IsNullOrWhiteSpace(Data.AssessmentJustification))
                            {
                                <MudTooltip Text="View Justifications">
                                    <MudIconButton OnClick="@ExpandParticipantJustifications"
                                                   Icon="@Icons.Material.Outlined.OpenInNew"
                                                   Size="Size.Small"
                                                   aria-label="View Justifications" />
                                </MudTooltip>
                            }
                        </LabelActions>
                        <ChildContent>
                            @Data.EnrolmentLocation
                        </ChildContent>
                    </DataListItem>
                    <DataListItem Label="Nationality">
                        @(Data.IsConsentGranted ? Data.Nationality ?? "Not Set" : "Hidden until consent is approved")
                    </DataListItem>
                    <DataListItem Label="Consent Date" HelperText="@Data.GetConsentDateHelperText()">
                        @Data.DateOfFirstConsent
                    </DataListItem>
                    <DataListItem Label="Last Data Sync" HelperText="@Data.LastSync.Humanize()" >
                        @Data.LastSync.ToShortDateString()
                    </DataListItem>
                </ChildContent>
            </DataList>
        </MudCardContent>
        <MudCardActions>

        </MudCardActions>
    </MudCard>

}
