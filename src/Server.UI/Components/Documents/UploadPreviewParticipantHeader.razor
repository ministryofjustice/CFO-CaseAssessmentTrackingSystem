@using Cfo.Cats.Application.Features.Participants.DTOs
@using Cfo.Cats.Application.Features.Participants.Queries
@using Cfo.Cats.Server.UI.Components.Participants
@using Microsoft.AspNetCore.Components.Authorization

@inherits ParticipantComponent<ParticipantHeaderDetailsDto>

@if (Loading)
{
    <MudSkeleton Width="60%" />
}
else if (Data is not null)
{
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2">Participant</MudText>
            <MudText Typo="Typo.body1">@Data.FullName</MudText>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudText Typo="Typo.body2">Ref</MudText>
            <MudText Typo="Typo.body1">@ParticipantId</MudText>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudText Typo="Typo.body2">Status</MudText>
            <MudText Typo="Typo.body1">@Data.EnrolmentStatus.Name</MudText>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudText Typo="Typo.body2">DOB</MudText>
            <MudText Typo="Typo.body1">@(Data.DateOfBirth?.ToShortDateString() ?? "Hidden until consent is approved")</MudText>
        </MudStack>
    </MudPaper>
}

@code {
    // Dialogs sit outside the layout that cascades the user profile, so read it from the auth state
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser ??= (await AuthState).User.GetUserProfileFromClaim();
        await base.OnInitializedAsync();
    }

    protected override IQuery<Result<ParticipantHeaderDetailsDto>> CreateQuery()
        => new GetParticipantDetails.Query
        {
            CurrentUser = CurrentUser,
            ParticipantId = ParticipantId
        };
}
