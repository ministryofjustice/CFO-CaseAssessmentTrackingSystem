@inherits OwningComponentBase<IMediator>

@if (_visible)
{
    <MudTooltip Text="@(_hasLink ? "Help" : "No help set for this page (System Support)")">
        <MudIconButton Icon="@Icons.Material.Filled.Help"
                       Color="@(_hasLink ? Color.Primary : Color.Warning)"
                       Size="Size.Small"
                       OnClick="@OnClickAsync" />
    </MudTooltip>
}
