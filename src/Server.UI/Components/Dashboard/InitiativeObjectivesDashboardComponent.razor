@using Cfo.Cats.Application.Features.Dashboard.Queries

@inherits CatsComponent<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto[]>

@if (Loading)
{
    <MudLoading Text="Loading" />
}

@if (ErrorMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="Severity.Error">
        @ErrorMessage
    </MudAlert>
}

@if (Data is not null && Data.Any())
{
    <MudGrid Spacing="2" Class="mb-3">
        <!-- This is the left column -->
        <MudItem xs="12" sm="6">
            <MudChip T="string">Active (@TotalActive)</MudChip>
            <MudChip T="string">Completed (@TotalCompleted)</MudChip>
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-end align-center gap-3">
            @if (!VisualMode)
            {
                <InitiativeAutoComplete @bind-Value="_initiativeFilter" @bind-Value:after="OnInitiativeFilterChanged"
                                        ActiveOnly="false"
                                        Style="max-width: 260px;" 
                                        Label="Initiative" />
            }
            <MudSwitch T="bool" Value="ShowActiveOnly" ValueChanged="OnShowActiveOnlyChanged" Color="Color.Primary" Label="Show open objectives only" />
            <MudLoadingButton Variant="Variant.Filled"
                                Size="Size.Small"
                                Loading="@_downloading"
                                Disabled="@Loading"
                                OnClick="@OnExport"
                                StartIcon="@Icons.Material.Filled.Download"
                                Color="Color.Secondary">
                @ConstantString.Export
            </MudLoadingButton>
        </MudItem>
    </MudGrid>

    @if (VisualMode)
    {
        <div style="overflow: visible; margin-bottom: 120px;">
            <ApexCharts.ApexChart @key="ShowActiveOnly" TItem="InitiativeChartPoint" Options="Options" Height="650" Width="@("100%")">
                <ApexCharts.ApexPointSeries TItem="InitiativeChartPoint"
                                 Name="@($"Active ({TotalActive})")"
                                 Items="FilteredChartData"
                                 XValue="@(x => new[] { x.InitiativeCode, x.InitiativeDescription })"
                                 YValue="@(x => x.ActiveCount)"
                                 SeriesType="ApexCharts.SeriesType.Bar"
                                 ShowDataLabels="true"
                                 Color="#1976d2" />
                @if (!ShowActiveOnly && TotalCompleted > 0)
                {
                    <ApexCharts.ApexPointSeries TItem="InitiativeChartPoint"
                                     Name="@($"Completed ({TotalCompleted})")"
                                     Items="FilteredChartData"
                                     XValue="@(x => new[] { x.InitiativeCode, x.InitiativeDescription })"
                                     YValue="@(x => x.CompletedCount)"
                                     SeriesType="ApexCharts.SeriesType.Bar"
                                     ShowDataLabels="true"
                                     Color="#5cb85c" />
                }
            </ApexCharts.ApexChart>
        </div>
    }
    else
    {
        <MudTable Items="@FilteredRows"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  SortLabel="Sort By"
                  Class="mt-4">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.ParticipantName)">
                        Participant
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.OwnerDisplayName ?? string.Empty)">
                        Assignee
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.ObjectiveDescription)">
                        Objective
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.InitiativeObjectiveCreatedBy ?? string.Empty)">
                        Created By
                    </MudTableSortLabel>
                </MudTh>                
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.InitiativeCode)">
                        Initiative
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.ParticipantStartDate ?? DateOnly.MinValue)">
                        Start Date
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.ParticipantEndDate ?? DateOnly.MinValue)">
                        End Date
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.IsObjectiveCompleted)">
                        Objective Status
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.CompletedTasks)">
                        Task Status
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetInitiativeObjectivesDashboard.InitiativeObjectiveRowDto, object>(x => x.ActivityCount)">
                        Activities
                    </MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Participant">
                    <MudStack Spacing="0">
                        <MudText>@context.ParticipantName</MudText>
                        <MudLink Href="@($"/pages/workspace/participants/{context.ParticipantId}?from=initiatives")">
                            @context.ParticipantId
                        </MudLink>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Assignee">
                    <MudStack AlignItems="AlignItems.Start" Spacing="0">
                        <MudText Typo="Typo.body1">@context.OwnerDisplayName</MudText>
                        <MudText Typo="Typo.caption">@context.OwnerTenantName</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Objective">
                    <MudText Typo="Typo.body1">@context.ObjectiveDescription</MudText>
                </MudTd>
                <MudTd DataLabel="Created By">
                    <MudText Typo="Typo.body1">@context.InitiativeObjectiveCreatedBy</MudText>
                </MudTd>
                <MudTd DataLabel="Initiative">
                    <MudTooltip Text="@context.InitiativeDescription">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.InitiativeCode</MudChip>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Start Date">
                    <MudText Typo="Typo.body1">@(context.ParticipantStartDate?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </MudTd>
                <MudTd DataLabel="End Date">
                    <MudText Typo="Typo.body1">@(context.ParticipantEndDate?.ToString("dd/MM/yyyy") ?? "-")</MudText>
                </MudTd>
                <MudTd DataLabel="Objective Status">
                    @if (context.IsObjectiveCompleted)
                    {
                        @if (context.CompletedStatus == CompletionStatus.Done)
                        {
                            <MudChip T="string" Text="@context.CompletedStatus.Name" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Done" />
                        }
                        else if (context.CompletedStatus == CompletionStatus.NotRequired)
                        {
                            <MudChip T="string" Text="@context.CompletedStatus.Name" Size="Size.Small" Color="Color.Dark" Icon="@Icons.Material.Filled.Close" />
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Active</MudChip>
                        }
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">Active</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Task Status">
                    <MudText Typo="Typo.body1">@context.TaskSummary</MudText>
                </MudTd>
                <MudTd DataLabel="Activities">
                    <MudText Typo="Typo.body1">@context.ActivityCount</MudText>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="[10, 20, 30]" />
            </PagerContent>
        </MudTable>
    }
}
else
{
    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">No data available</MudText>
}
