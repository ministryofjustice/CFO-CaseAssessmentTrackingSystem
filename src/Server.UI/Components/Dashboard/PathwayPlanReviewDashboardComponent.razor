@using Cfo.Cats.Application.Features.Dashboard.Queries

@inherits CatsComponent<GetPathwayPlans.PathwayPlanDto>

@if (Loading)
{
    <MudLoading Text="Loading" />
}

@if (ErrorMessage is not null)
{
    <MudAlert Variant="Variant.Filled" Severity="Severity.Error">
        @ErrorMessage
    </MudAlert>
}

@if (Data is not null && Data.TabularData.Any())
{
    <MudStack Row="true" Class="pb-2" Spacing="1">
        <MudChip T="string" Color="Color.Info" Variant="Variant.Text">Custody (@CustodyCount)</MudChip>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Text">Community (@CommunityCount)</MudChip>
    </MudStack>

    @if(VisualMode)
    {
        <div style="overflow: visible; margin-bottom: 120px;">
            <ApexCharts.ApexChart @key="ChartKey" TItem="GetPathwayPlans.LocationDetail" Options="Options" Height="650" Width="@("100%")">
                @if (!ShowOverdueOnly && TotalReviewed > 0)
                {
                    <ApexCharts.ApexPointSeries TItem="GetPathwayPlans.LocationDetail"
                                                Items="ChartData"
                                                Name="@($"Reviewed ({TotalReviewed})")"
                                                SeriesType="ApexCharts.SeriesType.Bar"
                                                XValue="@(e => e.LocationName)"
                                                YValue="@(e => e.TotalCount - e.OverdueCount)"
                                                ShowDataLabels="true"
                                                Color="#5cb85c">
                    </ApexCharts.ApexPointSeries>
                }

                <ApexCharts.ApexPointSeries TItem="GetPathwayPlans.LocationDetail"
                                            Items="FilteredChartData"
                                            Name="@($"Reviewed 3+ months ago ({TotalOverdueCount})")"
                                            SeriesType="ApexCharts.SeriesType.Bar"
                                            XValue="@(e => e.LocationName)"
                                            YValue="@(e => e.OverdueCount)"
                                            ShowDataLabels="true"
                                            Color="#d9534f">
                </ApexCharts.ApexPointSeries>
            </ApexCharts.ApexChart>
        </div>
    }
    else
    {
        <MudTable Dense="true" Items="FilteredTabularData" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetPathwayPlans.PathwayPlanReviewTabularData, object>(x => x.ParticipantName!)">
                        Participant
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetPathwayPlans.PathwayPlanReviewTabularData, object>(x => x.ParticipantCurrentLocation!)">
                        Participant Location
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetPathwayPlans.PathwayPlanReviewTabularData, object>(x => x.ReviewLocation!)">
                        Review Location
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetPathwayPlans.PathwayPlanReviewTabularData, object>(x => x.ReviewReason!.Name!)">
                        Review Reason
                    </MudTableSortLabel>
                </MudTh>                
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<GetPathwayPlans.PathwayPlanReviewTabularData, object>(x => x.ReviewDate ?? DateTime.MinValue)">
                        Reviewed On
                    </MudTableSortLabel>
                </MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Participant">
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudStack AlignItems="AlignItems.Start" Spacing="0">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="0">                
                                <MudText>@context.ParticipantName</MudText>
                                <MudChip T="string" Size="Size.Small" Style="@($"background-color:{context.EnrolmentStatus!.Colour}; color:white;")">
                                    @context.EnrolmentStatus
                                </MudChip>
                            </MudStack>                    
                            <MudLink Typo="Typo.body1" Href=@($"/pages/workspace/participants/{context.ParticipantId}?from=pathway-plan-reviews")>
                                @context.ParticipantId
                            </MudLink>
                        </MudStack>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Participant Location">
                    <MudText Typo="Typo.body1">@context.ParticipantCurrentLocation</MudText>
                </MudTd>
                <MudTd DataLabel="Review Location">
                    <MudText>@context.ReviewLocation</MudText>
                </MudTd>
                <MudTd DataLabel="Review Reason">
                    @if (context.ReviewReason != PathwayPlanReviewReason.Default)
                    {
                        <MudText>@context.ReviewReason</MudText>
                    }else{
                        <MudText>Not reviewed yet</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Reviewed On">
                    <MudStack Row AlignItems="AlignItems.Center">
                        @if (context.ReviewDate != null)
                        {
                            <MudText>@context.ReviewDate?.ToShortDateString() by @context.ReviewedBy</MudText>
                            @if (context.IsOverdue)
                            {
                                <MudTooltip Text="Needs review - last reviewed 3+ months ago.">
                                    <MudIcon Icon="@Icons.Material.Rounded.Warning" Color="Color.Warning" Size="Size.Small" />
                                </MudTooltip>
                            }                                
                            @if (string.IsNullOrEmpty(context.ReviewNotes) is false)
                            {
                                <MudIconButton Icon="@Icons.Material.Rounded.Info" 
                                               Color="Color.Info" 
                                               Size="Size.Small" 
                                               OnClick="@(() => ShowReviewNotes(context.ReviewNotes))" />
                            }
                        }
                        else
                        {
                            <MudText>Not reviewed yet</MudText>
                        }
                    </MudStack>                
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body1" Color="Color.Secondary">No pathway plans match the selected filters</MudText>
            </NoRecordsContent>
			<PagerContent>
				<MudTablePager PageSizeOptions="[10, 20, 30]" />
			</PagerContent>
        </MudTable>
    }
}
else
{
    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">No data available</MudText>
}
