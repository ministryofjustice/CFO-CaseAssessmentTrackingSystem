@using Cfo.Cats.Server.UI.Components.Users

<MudDialog>
	<DialogContent>
		<div style="min-width: 600px;">
			<UserSelectComponent ValueChanged="OnUserSelectedChanged" TenantId="@(CurrentUser.TenantId ?? string.Empty)" ActiveOnly="true" ShowAllOption="@ShowAllOption" AllOptionLabel="@AllOptionLabel" />
		</div>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@Dialog.Cancel">@ConstantString.Cancel</MudButton>
		<MudLoadingButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CheckCircle" Loading="_saving" OnClick="@Submit" Disabled="@(!_hasSelection)">@ConstantString.Ok</MudLoadingButton>
	</DialogActions>
</MudDialog>
