
@using Cfo.Cats.Application.Common.Interfaces.Locations
@using Cfo.Cats.Application.Features.Delius.DTOs
@using Cfo.Cats.Application.Features.Locations.DTOs
@using Cfo.Cats.Domain.Common.Enums
@using DocumentFormat.OpenXml.Office2013.PowerPoint.Roaming
@using System.Linq.Expressions

@inject ILocationService LocationService

<MudSelectExtended 
    T="LocationDto"
    ItemCollection="@_locations"
    Value="Value"
    ValueChanged="HandleValueChanged"
    Label="@Label"
    Placeholder="Select a location"
    Required="false"
    Disabled="@Disabled"
    For="@For"
    Variant="Variant.Outlined"
    SearchBox="true"
    SearchBoxAutoFocus="true"
    SearchBoxClearable="true"
    Clearable="true"
    SearchFunc="@(new Func<LocationDto?, string, bool>(Search))"
    ToStringFunc="@GetDisplayName">

</MudSelectExtended>

@code {

    [Parameter, EditorRequired]
    public string TenantId { get; set; } = null!;

    [Parameter] 
    public LocationDto? Value { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<LocationDto?> ValueChanged { get; set; }

    [Parameter]
    public Func<LocationDto, bool>? LocationFilter { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public Expression<Func<LocationDto?>>? For { get; set; }

    [Parameter]
    public bool ShowAllOption { get; set; }

    [Parameter]
    public string AllOptionLabel { get; set; } = "All Locations";

    private LocationDto[] _locations = [];

    private LocationDto AllLocationsOption => new()
    {
        Id = 0,
        Name = AllOptionLabel,
        ContractName = string.Empty,
        GenderProvision = GenderProvision.Any,
        LocationType = LocationType.Unknown
    };

    private async Task HandleValueChanged(LocationDto? locationDto)
    {
        Value = locationDto;
        await ValueChanged.InvokeAsync(Value);
    }

    private string GetDisplayName(LocationDto? locationDto) => locationDto?.Name ?? string.Empty;

    protected override void OnInitialized()
    {
        var locations = LocationService.GetVisibleLocations(TenantId).OrderBy(l => l.Name);
        var filtered = (LocationFilter is not null ? locations.Where(LocationFilter) : locations).ToArray();

        _locations = ShowAllOption ? [AllLocationsOption, .. filtered] : filtered;
    }

    private bool Search(LocationDto? location, string searchText)
    {
        if (location == null)
        {
            return true;
        }

        if (location.Name.Contains(searchText, StringComparison.CurrentCultureIgnoreCase))
        {
            return true;
        }

        if(location.LocationType.Name.Contains(searchText, StringComparison.CurrentCultureIgnoreCase))
        {
            return true;
        }       

        if(location.GenderProvision.Name.Contains(searchText, StringComparison.CurrentCultureIgnoreCase))
        {
            return true;
        }
        return false;
    }

}